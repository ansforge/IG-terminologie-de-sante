Instance: name-system-sms
InstanceOf: NamingSystem
Title: "SMS - Dictionnaire des substances entrant dans la composition de médicaments"
Description: "Le dictionnaire des substances ou SMS a été conçu par l’European Medicines Agency (EMA) dans le cadre d’une démarche qualité. Ce dictionnaire contient les substances entrant dans la composition de médicaments destinés à un humain et/ou vétérinaire."
Usage: #definition
* name = "SMS"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "2.16.840.1.113883.3.6905.2"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://smt.esante.gouv.fr/terminologie-sms/"
* uniqueId[=].preferred = true
