Instance: name-system-ncbi-taxonomy
InstanceOf: NamingSystem
Title: "NCBITaxonomy - Classification phylogénétique de l’ensemble du règne du vivant"
Description: "La NCBI Taxonomie est une classification phylogénétique de l’ensemble du règne du vivant servant de référence pour indexer les bases de données de séquences (génétiques, protéomique, etc.). La version publiée sur le SMT propose une curation automatique du règne Procaryote ne conservant que les taxons pertinents pour l’interopérabilité (exclusion des échantillons environnementaux, etc.) et enrichie avec des alignements vers d’autres référentiels tel que la CIM-11, le NCIT ou LOINC."
Usage: #definition
* name = "NCBITaxonomy"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "2.16.840.1.113883.3.9471"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://smt.esante.gouv.fr/terminologie-ncbi-taxonomy/"
* uniqueId[=].preferred = true
