Instance: name-system-tnm8uicc
InstanceOf: NamingSystem
Title: "TNM8UICC - Classification des tumeurs malignes - 8ème édition"
Description: "Publiée par l'Union for International Cancer Control (UICC), la classification TNM des tumeurs malignes est une norme reconnue mondialement pour classer l'étendue de la propagation du cancer."
Usage: #definition
* name = "TNM8UICC"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "2.16.840.1.113883.15.16"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://www.uicc.org/resources/tnm"
* uniqueId[=].preferred = true
