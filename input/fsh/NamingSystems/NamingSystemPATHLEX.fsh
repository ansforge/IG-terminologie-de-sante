Instance: name-system-pathlex
InstanceOf: NamingSystem
Title: "PATHLEX - Lexique des observations en anatomie et cytologie pathologiques"
Description: "PathLex est un lexique complet de termes de pathologie anatomique pour l’indexation et la récupération standardisées des ressources d’information en pathologie anatomique."
Usage: #definition
* name = "PATHLEX"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "1.3.6.1.4.1.19376.1.8.2.1"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://bioportal.bioontology.org/ontologies/PATHLEX"
* uniqueId[=].preferred = true
