Instance: name-system-standard-terms-edqm
InstanceOf: NamingSystem
Title: "StandardTermsEDQM - Liste des termes standardisés descripteurs de médicaments"
Description: "Les standard terms (ou listes de termes normalisés) ont été établis en réponse à une demande de la Commission européenne. Ils contiennent les formes pharmaceutiques, les voies et/ou les méthodes d’administration, les unités de présentation, ainsi que les conditionnements, les systèmes de fermeture et les dispositifs d’administration des médicaments à usage humain et/ou vétérinaire. (Source EMA)"
Usage: #definition
* name = "StandardTermsEDQM"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "0.4.0.127.0.16.1.1.2.1"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://smt.esante.gouv.fr/terminologie-standardterms"
* uniqueId[=].preferred = true
