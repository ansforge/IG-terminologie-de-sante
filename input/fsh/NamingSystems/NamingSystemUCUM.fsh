Instance: name-system-ucum
InstanceOf: NamingSystem
Title: "UCUM - Référentiel unifié des unités de mesure"
Description: "UCUM est un système de codage des unités de mesure utilisées dans les domaines scientifique, technique et commercial international. Son objectif est de faciliter la communication électronique sans ambiguïté des quantités et de leurs unités."
Usage: #definition
* name = "UCUM"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "2.16.840.1.113883.6.8"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "http://unitsofmeasure.org"
* uniqueId[=].preferred = true
