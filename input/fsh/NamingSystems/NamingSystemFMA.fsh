Instance: name-system-fma
InstanceOf: NamingSystem
Title: "FMA - Ontologie du Modèle Fondamental d'Anatomie"
Description: "FMA  est une source de connaissances informatiques évolutive destinée à l'informatique biomédicale. Elle s'intéresse à la représentation des classes ou types et des relations nécessaires à la représentation symbolique de la structure phénotypique du corps humain, sous une forme compréhensible par les humains et navigable, analysable et interprétable par les systèmes automatisés."
Usage: #definition
* name = "FMA"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "2.16.840.1.113883.6.119"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "http://sig.biostr.washington.edu/projects/fm/AboutFM.html"
* uniqueId[=].preferred = true
