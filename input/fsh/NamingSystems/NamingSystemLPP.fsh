Instance: name-system-lpp
InstanceOf: NamingSystem
Title: "LPP - Liste des produits et prestations"
Description: "La LPP est la liste des produits et prestations remboursables par l'Assurance Maladie. Il s'agit notamment des dispositifs médicaux pour traitements et matériels d'aide à la vie, aliments diététiques et articles pour pansements, des orthèses et prothèses externes, des dispositifs médicaux implantables et des véhicules pour handicapés physiques."
Usage: #definition
* name = "LPP"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "1.2.250.1.215.300.4"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://www.ameli.fr/etablissement/exercice-professionnel/nomenclatures-codage/lpp"
* uniqueId[=].preferred = true
