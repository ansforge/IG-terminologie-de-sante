Instance: name-system-adicap
InstanceOf: NamingSystem
Title: "ADICAP - Index raisonné des lésions"
Description: "Système de codage comportant les modes de prélèvement; types de technique; appareils, organes et régions; pathologie générale non tumorale; pathologie tumorale ; lésions particulières d’organe; cytopathologie et topographies."
Usage: #definition
* name = "ADICAP"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "1.2.250.1.213.2.11"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://smt.esante.gouv.fr/terminologie-adicap"
* uniqueId[=].preferred = true
