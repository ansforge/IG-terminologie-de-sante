Instance: name-system-ihe-role-code
InstanceOf: NamingSystem
Title: "IHERoleCode - Roles complémentaires (non présents dans HL7)."
Description: "Le vocabulaire IHERoleCode est un petit vocabulaire de rôles qui ne sont pas actuellement pris en charge par le vocabulaire des rôles HL7."
Usage: #definition
* name = "IHERoleCode"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "1.3.6.1.4.1.19376.1.5.3.3"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://wiki.ihe.net/index.php/IHERoleCode_Vocabulary"
* uniqueId[=].preferred = true
