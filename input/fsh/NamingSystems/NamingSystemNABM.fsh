Instance: name-system-nabm
InstanceOf: NamingSystem
Title: "NABM - Nomenclature des actes de biologie médicale"
Description: "La NABM est la terminologie de facturation des actes de biologie médicale. Elle décrit la liste des actes de biologie dans une arborescence en chapitres et sous-chapitres ainsi que des règles de facturation."
Usage: #definition
* name = "NABM"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "1.2.250.1.215.300.2"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://smt.esante.gouv.fr/terminologie-nabm/"
* uniqueId[=].preferred = true
