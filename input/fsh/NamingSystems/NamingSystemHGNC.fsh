Instance: name-system-hgnc
InstanceOf: NamingSystem
Title: "HGNC - Nomenclature des gènes humains"
Description: "HGNC est chargé d'approuver les symboles et les noms uniques des loci humains, y compris les gènes codant pour les protéines, les gènes ncRNA et les pseudogènes, afin de permettre une communication scientifique sans ambiguïté."
Usage: #definition
* name = "HGNC"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "2.16.840.1.113883.6.281"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "http://www.genenames.org"
* uniqueId[=].preferred = true
