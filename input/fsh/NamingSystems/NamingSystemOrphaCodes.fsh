Instance: name-system-orpha-codes
InstanceOf: NamingSystem
Title: "OrphaCodes - Nomenclature des maladies rares"
Description: "Non publiée sur le SMT  L'ontologie des maladies rares ORDO (Orphanet Rare Disease Ontology) est issue de la base de données Orphanet disponible sur orphadata.org. Elle rassemble les concepts de maladies et de groupes de maladies  rares. Plus de détails sur https://www.orpha.net/"
Usage: #definition
* name = "OrphaCodes"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "1.2.250.1.213.2.49"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://www.orphadata.com/orphanet-nomenclature-for-coding/"
* uniqueId[=].preferred = true
