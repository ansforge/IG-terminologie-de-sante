Instance: name-system-hpo
InstanceOf: NamingSystem
Title: "HPO - Ontologie du phénotype humain"
Description: "HPO fournit un vocabulaire standardisé des anomalies phénotypiques rencontrées dans les maladies humaines."
Usage: #definition
* name = "HPO"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "2.16.840.1.113883.6.339"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "http://human-phenotype-ontology.org"
* uniqueId[=].preferred = true
