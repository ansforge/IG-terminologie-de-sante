Instance: name-system-iso3166-part1
InstanceOf: NamingSystem
Title: "ISO3166Part1 - Codes à deux lettres (alpha-2) des noms de pays"
Description: "La norme ISO 3166-1:2013 est destinée à toute application nécessitant l'expression des noms de pays sous une forme codée. Elle contient également des principes directeurs de sa mise en application et de sa mise à jour (source site AFNOR)."
Usage: #definition
* name = "ISO3166Part1"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "1.0.3166.1"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "urn:iso:std:iso:3166"
* uniqueId[=].preferred = true
