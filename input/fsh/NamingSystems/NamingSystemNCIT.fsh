Instance: name-system-ncit
InstanceOf: NamingSystem
Title: "NCIT - Terminologie multi-domaine exploitable en production de soin"
Description: "Le National Cancer Institute Thesaurus (NCIt), terminologie multi-domaine, construit par le National Cancer Institute. Le NCIt est fondé sur : 1) Un code unique et pérenne par concepts ; 2) Des informations terminologiques et des alignements sur des ressources externes ; 3) Plus de 100 000 définitions textuelles et 500 000 relations sémantiques. La version publiée sur le SMT propose des traductions validées ou automatiques pour faciliter son usage dans un cadre francophone."
Usage: #definition
* name = "NCIT"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "2.16.840.1.113883.3.26.1.1"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl"
* uniqueId[=].preferred = true
* uniqueId[+].type = #uri
* uniqueId[=].value = "https://smt.esante.gouv.fr/terminologie-ncit"
* uniqueId[=].preferred = false
* uniqueId[=].comment = "Ancienne URI, obsolète. Remplacée par http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl."
