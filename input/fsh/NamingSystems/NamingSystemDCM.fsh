Instance: name-system-dcm
InstanceOf: NamingSystem
Title: "DCM - DICOM Controlled Terminology"
Description: "Concepts codés définis dans PS 3.16 Digital Imaging and Communications in Medicine (DICOM): Part 16: Content Mapping Resource, Annex D: DICOM Controlled Terminology Definition"
Usage: #definition
* name = "DCM"
* status = #active
* kind = #codesystem
* date = "2026-11-25"
* uniqueId[0].type = #oid
* uniqueId[=].value = "1.2.840.10008.2.16.4"
* uniqueId[=].preferred = false
* uniqueId[+].type = #uri
* uniqueId[=].value = "http://dicom.nema.org/resources/ontology/DCM"
* uniqueId[=].preferred = true
