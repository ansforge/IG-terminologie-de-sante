int/browse/2026-01/icf/fr#680339969/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#680339969/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/680339969/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/680339969/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d770</td><td/><td>Intimate relationships, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d5108<a name=\"terminologie-icf-d5108\"> </a></td><td>Autres activités précisées relatives au fait de se laver</td><td/><td>d510</td><td>d5108</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1882548282/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1882548282/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1882548282/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1882548282/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d510</td><td/><td>Other specified washing oneself</td></tr><tr><td style=\"white-space:nowrap\">d9109<a name=\"terminologie-icf-d9109\"> </a></td><td>Domaines non précisés de la vie communautaire</td><td/><td>d910</td><td>d9109</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1873256446/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1873256446/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1873256446/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1873256446/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d910</td><td/><td>Community life, unspecified</td></tr><tr><td style=\"white-space:nowrap\">e570<a name=\"terminologie-icf-e570\"> </a></td><td>Services, systèmes et politiques relatifs à la sécurité sociale</td><td><div><p>Services, systèmes et politiques visant à assur