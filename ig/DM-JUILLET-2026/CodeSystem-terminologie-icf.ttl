ho.int/icd/entity/941161899</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#941161899</code>, <code>https://icd.who.int/browse/2026-01/icf/en#941161899</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/941161899/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/941161899/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d330-d349</td><td/><td>Producing messages in formal sign language</td></tr><tr><td style=\"white-space:nowrap\">d4302<a name=\"terminologie-icf-d4302\"> </a></td><td>Porter dans les bras</td><td><div><p>Prendre ou transporter un objet d'un endroit à un autre avec les bras et les mains, comme pour porter un animal de compagnie, un enfant ou un autre objet de taille importante.</p>\n</div></td><td>d430</td><td>d4302</td><td><code>http://id.who.int/icd/entity/815067248</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#815067248</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#815067248</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/815067248/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/815067248/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d430</td><td/><td>Carrying in the arms</td></tr><tr><td style=\"white-space:nowrap\">b750<a name=\"terminologie-icf-b750\"> </a></td><td>Fonctions relatives aux réflexes moteurs</td><td><div><p>Fonctions relatives aux contractions involontaires des muscles automatiquement provoquées par des stimuli précisés.</p>\n</div></td><td>b750-b789</td><td>b750</td><td><code>http://id.who.int/icd/entity/1777008610</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1777008610</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1777008610</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1777008610/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b750-b789</td><td>b7501, b7502, b7500, b7508, b7509</td><td>Motor reflex functions</td></tr><tr><td style=\"white-space:nowrap\">d4458<a name=\"terminologie-icf-d4458\"> </a></td><td>Autres activités précisées d'utilisation des mains et des bras</td><td/><td>d445</td><td>d4458</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1420660403/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1420660403/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1420660403/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1420660403/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d445</td><td/><td>Other specified hand and arm use</td></tr><tr><td style=\"white-space:nowrap\">s499<a name=\"terminologie-icf-s499\"> </a></td><td>Structures non précisées des systèmes cardio-vasculaire, immunitaire et respiratoire</td><td/><td>s410-s499</td><td>s499</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#521411479/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#521411479/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/521411479/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/521411479/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s410-s499</td><td/><td>Structures of the cardiovascular, immunological and respiratory systems, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d9204<a name=\"terminologie-icf-d9204\"> </a></td><td>Hobby</td><td><div><p>S'adonner à des passe-temps, comme collectionner des timbres (ou par exemple les pièces de monnaie, les objets anciens, les pierres précieuses, les coquillages ou les images), observer les oiseaux ou faire de l’astronomie.</p>\n</div></td><td>d920</td><td>d9204</td><td><code>http://id.who.int/icd/entity/1347031578</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1347031578</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1347031578</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1347031578/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1347031578/postcoordinationScale/performance</code></td><td/><td/><td/><td>d920</td><td/><td>Hobbies</td></tr><tr><td style=\"white-space:nowrap\">d7402<a name=\"terminologie-icf-d7402\"> </a></td><td>Relations avec ses pairs</td><td><div><p>Établir et entretenir des relations spécifiques avec des personnes occupant la même position, ou jouissant du même rang ou du même prestige que soi-même en termes de position sociale.</p>\n</div></td><td>d740</td><td>d7402</td><td><code>http://id.who.int/icd/entity/360084367</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#360084367</code>, <code>https://icd.who.int/browse/2026-01/icf/en#360084367</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/360084367/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/360084367/postcoordinationScale/performance</code></td><td/><td/><td/><td>d740</td><td/><td>Relating with equals</td></tr><tr><td style=\"white-space:nowrap\">s75020<a name=\"terminologie-icf-s75020\"> </a></td><td>Os de la cheville et du pied</td><td/><td>s7502</td><td>s75020</td><td><code>http://id.who.int/icd/entity/1650503157</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1650503157</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1650503157</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1650503157/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1650503157/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s7502</td><td/><td>Bones of ankle and foot</td></tr><tr><td style=\"white-space:nowrap\">b510-b599<a name=\"terminologie-icf-b510-b599\"> </a></td><td>Fonctions des systèmes digestif, métabolique et endocrinien</td><td><div><p>Ce chapitre traite des fonctions d'ingestion, de digestion et d'élimination, de même que des fonctions du métabolisme et des glandes endocrines.</p>\n</div></td><td>b110-b899</td><td/><td><code>http://id.who.int/icd/entity/850289698</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#850289698</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#850289698</code></td><td/><td>BlockL2-b51</td><td>b510-b599</td><td/><td>b110-b899</td><td>b510-b539, b540-b559, b599, b598</td><td>Functions of the digestive, metabolic and endocrine systems</td></tr><tr><td style=\"white-space:nowrap\">b4509<a name=\"terminologie-icf-b4509\"> </a></td><td>Fonctions additionnelles non précisées du système respiratoire</td><td/><td>b450</td><td>b4509</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1682107878/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1682107878/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1682107878/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b450</td><td/><td>Additional functions of the respiratory system, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b1268<a name=\"terminologie-icf-b1268\"> </a></td><td>Autres fonctions précisées du tempérament et de la personnalité</td><td/><td>b126</td><td>b1268</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#366825380/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#366825380/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/366825380/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b126</td><td/><td>Other specified temperament and personality functions</td></tr><tr><td style=\"white-space:nowrap\">s8201<a name=\"terminologie-icf-s8201\"> </a></td><td>Glandes sébacées</td><td/><td>s820</td><td>s8201</td><td><code>http://id.who.int/icd/entity/541553153</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#541553153</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#541553153</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/541553153/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/541553153/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s820</td><td/><td>Sebaceous glands</td></tr><tr><td style=\"white-space:nowrap\">e1400<a name=\"terminologie-icf-e1400\"> </a></td><td>Produits et systèmes techniques généraux pour la culture, les loisirs et le sport</td><td><div><p>Produits, équipements et systèmes techniques utilisés pour la culture, les loisirs et le sport, comme des jouets, des skis, des balles de tennis, des pistolets et carabines de sport, des instruments de musique, et qui n'ont pas été adaptés ou spécialement conçus.</p>\n</div></td><td>e140</td><td>e1400</td><td><code>http://id.who.int/icd/entity/49960777</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#49960777</code>, <code>https://icd.who.int/browse/2026-01/icf/en#49960777</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/49960777/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e140</td><td/><td>General products and technology for culture, recreation and sport</td></tr><tr><td style=\"white-space:nowrap\">b270<a name=\"terminologie-icf-b270\"> </a></td><td>Fonctions sensorielles liées à la température et à d'autres stimuli</td><td><div><p>Fonctions sensorielles de perception des stimuli liés à la température, aux vibrations, à la pression et des stimuli nocifs.</p>\n</div></td><td>b250-b279</td><td>b270</td><td><code>http://id.who.int/icd/entity/2102920100</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2102920100</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2102920100</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2102920100/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b250-b279</td><td>b2702, b2708, b2700, b2701, b2703, b2709</td><td>Sensory functions related to temperature and other stimuli</td></tr><tr><td style=\"white-space:nowrap\">s11002<a name=\"terminologie-icf-s11002\"> </a></td><td>Lobe pariétal</td><td/><td>s1100</td><td>s11002</td><td><code>http://id.who.int/icd/entity/446568000</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#446568000</code>, <code>https://icd.who.int/browse/2026-01/icf/en#446568000</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/446568000/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/446568000/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s1100</td><td/><td>Parietal lobe</td></tr><tr><td style=\"white-space:nowrap\">e1150<a name=\"terminologie-icf-e1150\"> </a></td><td>Produits et systèmes techniques existant sur le marché à usage personnel dans la vie quotidienne</td><td><div><p>Produits, équipements, systèmes techniques utilisés dans la vie quotidienne, comme des vêtements, des tissus, du mobilier, des appareils, des produits de nettoyage et des outils, et qui n'ont pas été adaptés ou spécialement conçus.</p>\n</div></td><td>e115</td><td>e1150</td><td><code>http://id.who.int/icd/entity/659594362</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#659594362</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#659594362</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/659594362/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e115</td><td/><td>General products and technology for personal use in daily living</td></tr><tr><td style=\"white-space:nowrap\">s8108<a name=\"terminologie-icf-s8108\"> </a></td><td>Autre structure précisée des aires de la peau</td><td/><td>s810</td><td>s8108</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1746134038/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1746134038/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1746134038/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1746134038/other/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s810</td><td/><td>Other specified structure of areas of skin</td></tr><tr><td style=\"white-space:nowrap\">d610-d699<a name=\"terminologie-icf-d610-d699\"> </a></td><td>Vie domestique</td><td><div><p>Ce chapitre porte sur l'exécution des actions et des tâches de la vie domestique et de la vie courante. Elles concernent notamment l'acquisition d'un endroit pour vivre, des aliments, des vêtements et autres produits d'usage courant, les activités ménagères de nettoyage et de réparation, l'entretien de ses biens personnels et autres objets ménagers, et l'aide apportée aux autres.</p>\n</div></td><td>d110-d999</td><td/><td><code>http://id.who.int/icd/entity/1535125568</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1535125568</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1535125568</code></td><td/><td>BlockL2-d61</td><td>d610-d699</td><td/><td>d110-d999</td><td>d650-d669, d630-d649, d610-d629, d699, d698</td><td>Domestic life</td></tr><tr><td style=\"white-space:nowrap\">e5352<a name=\"terminologie-icf-e5352\"> </a></td><td>Politiques relatives à la communication</td><td><div><p>Textes législatifs, réglementations et normes régissant la transmission de l'information par différents moyens comme le téléphone, la télécopie, le courrier, le courrier électronique et autres systèmes informatisés, comme les textes relatifs au droit d'accès aux services de communication, les exigences pour disposer d'une adresse postale, et les normes en matière de télécommunications.</p>\n</div></td><td>e535</td><td>e5352</td><td><code>http://id.who.int/icd/entity/446556899</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#446556899</code>, <code>https://icd.who.int/browse/2026-01/icf/en#446556899</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/446556899/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e535</td><td/><td>Communication policies</td></tr><tr><td style=\"white-space:nowrap\">s63031<a name=\"terminologie-icf-s63031\"> </a></td><td>Grandes lèvres</td><td/><td>s6303</td><td>s63031</td><td><code>http://id.who.int/icd/entity/844021418</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#844021418</code>, <code>https://icd.who.int/browse/2026-01/icf/en#844021418</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/844021418/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/844021418/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s6303</td><td/><td>Labia majora</td></tr><tr><td style=\"white-space:nowrap\">b6702<a name=\"terminologie-icf-b6702\"> </a></td><td>Sensations associées à la ménopause</td><td><div><p>Sensations associées à l'arrêt du cycle menstruel.</p>\n</div></td><td>b670</td><td>b6702</td><td><code>http://id.who.int/icd/entity/1876306268</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1876306268</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1876306268</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1876306268/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b670</td><td/><td>Sensations associated with menopause</td></tr><tr><td style=\"white-space:nowrap\">e5551<a name=\"terminologie-icf-e5551\"> </a></td><td>Systèmes relatifs aux associations et aux services d'entraide</td><td><div><p>Mécanismes de contrôle administratif et de surveillance régissant les relations et des activités des personnes qui se regroupent en ayant des intérêts communs à but non commercial, les normes qui doivent présider à la mise en place et à la gestion de ces associations, qu'il s'agisse de sociétés d'entraide, de sociétés de loisirs, d'associations culturelles et religieuses, ou d'organisations sans but lucratif.</p>\n</div></td><td>e555</td><td>e5551</td><td><code>http://id.who.int/icd/entity/473668116</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#473668116</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#473668116</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/473668116/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e555</td><td/><td>Associations and organizational systems</td></tr><tr><td style=\"white-space:nowrap\">b4459<a name=\"terminologie-icf-b4459\"> </a></td><td>Fonctions non précisées des muscles respiratoires</td><td/><td>b445</td><td>b4459</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1360101629/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1360101629/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1360101629/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b445</td><td/><td>Respiratory muscle functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d2308<a name=\"terminologie-icf-d2308\"> </a></td><td>Effectuer d'autres routines quotidiennes précisées</td><td/><td>d230</td><td>d2308</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2018794819/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2018794819/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2018794819/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/2018794819/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d230</td><td/><td>Other specified carrying out daily routine</td></tr><tr><td style=\"white-space:nowrap\">b43500<a name=\"terminologie-icf-b43500\"> </a></td><td>Réaction immunitaire spécifique</td><td><div><p>Fonctions de la réaction de l'organisme après sensibilisation à une substance étrangère spécifique.</p>\n</div></td><td>b4350</td><td>b43500</td><td><code>http://id.who.int/icd/entity/615771736</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#615771736</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#615771736</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/615771736/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b4350</td><td/><td>Specific immune response</td></tr><tr><td style=\"white-space:nowrap\">e315<a name=\"terminologie-icf-e315\"> </a></td><td>Famille élargie</td><td><div><p>Personnes liées par la naissance, par alliance ou par d'autres relations, culturellement reconnues comme constituant la famille élargie, comme les tantes, oncles, nièces, neveux.</p>\n</div></td><td>e310-e399</td><td>e315</td><td><code>http://id.who.int/icd/entity/1710814192</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1710814192</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1710814192</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1710814192/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e310-e399</td><td/><td>Extended family</td></tr><tr><td style=\"white-space:nowrap\">s7203<a name=\"terminologie-icf-s7203\"> </a></td><td>Ligaments et fascia de la région des épaules</td><td/><td>s720</td><td>s7203</td><td><code>http://id.who.int/icd/entity/129081402</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#129081402</code>, <code>https://icd.who.int/browse/2026-01/icf/en#129081402</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/129081402/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/129081402/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s720</td><td/><td>Ligaments and fasciae of shoulder region</td></tr><tr><td style=\"white-space:nowrap\">s6109<a name=\"terminologie-icf-s6109\"> </a></td><td>Structure non précisée du système immunitaire</td><td/><td>s610</td><td>s6109</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#48501785/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#48501785/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/48501785/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/48501785/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s610</td><td/><td>Structure of urinary system, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d1311<a name=\"terminologie-icf-d1311\"> </a></td><td>Apprendre à travers des actions qui mettent en relation des objets</td><td><div><p>Actions simples mettant en relation deux ou plusieurs objets, jouets ou autre matériel en ne tenant pas compte des propriétés spécifiques des objets, des jouets ou du matériel.</p>\n</div></td><td>d131</td><td>d1311</td><td><code>http://id.who.int/icd/entity/1884606082</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1884606082</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1884606082</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1884606082/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1884606082/postcoordinationScale/performance</code></td><td/><td/><td/><td>d131</td><td/><td>Learning through actions by relating objects</td></tr><tr><td style=\"white-space:nowrap\">e5600<a name=\"terminologie-icf-e5600\"> </a></td><td>Services relatifs aux médias</td><td><div><p>Services et programmes, y compris des personnes qui s'en occupent, visant à assurer les communications de masse, comme la radio, la télévision, les reportages de presse, les journaux, les sous-titrages, les services en braille, les services de communication informatisés (web, Internet).</p>\n</div></td><td>e560</td><td>e5600</td><td><code>http://id.who.int/icd/entity/292022356</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#292022356</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#292022356</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/292022356/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e560</td><td/><td>Media services</td></tr><tr><td style=\"white-space:nowrap\">d1322<a name=\"terminologie-icf-d1322\"> </a></td><td>Acquérir la syntaxe</td><td><div><p>Apprendre à produire des phrases ou des ensembles de phrases construits de manière appropriée.</p>\n</div></td><td>d132</td><td>d1322</td><td><code>http://id.who.int/icd/entity/288541418</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#288541418</code>, <code>https://icd.who.int/browse/2026-01/icf/en#288541418</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/288541418/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/288541418/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d132</td><td/><td>Acquiring syntax</td></tr><tr><td style=\"white-space:nowrap\">b4359<a name=\"terminologie-icf-b4359\"> </a></td><td>Fonctions non précisées du système immunitaire</td><td/><td>b435</td><td>b4359</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1611249546/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1611249546/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1611249546/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b435</td><td/><td>Immunological system functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b730<a name=\"terminologie-icf-b730\"> </a></td><td>Fonctions relatives à la puissance musculaire</td><td><div><p>Fonctions relatives à la force générée par la contraction d'un muscle ou de groupes de muscles.</p>\n</div></td><td>b730-b749</td><td>b730</td><td><code>http://id.who.int/icd/entity/274570113</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#274570113</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#274570113</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/274570113/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b730-b749</td><td>b7301, b7304, b7305, b7308, b7306, b7302, b7309, b7303, b7300</td><td>Muscle power functions</td></tr><tr><td style=\"white-space:nowrap\">b420<a name=\"terminologie-icf-b420\"> </a></td><td>Fonctions de la pression artérielle</td><td><div><p>Fonctions relatives au maintien de la pression sanguine dans les artères.</p>\n</div></td><td>b410-b429</td><td>b420</td><td><code>http://id.who.int/icd/entity/1432017555</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1432017555</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1432017555</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1432017555/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b410-b429</td><td>b4209, b4200, b4202, b4201, b4208</td><td>Blood pressure functions</td></tr><tr><td style=\"white-space:nowrap\">e435<a name=\"terminologie-icf-e435\"> </a></td><td>Attitudes individuelles des personnes en position de subordination</td><td><div><p>Opinions et points de vue généraux et spécifiques qu'ont les personnes en position de subordination sur la personne considérée ou sur d'autres sujets (par ex. enjeux sociaux, politiques et économiques) qui influent sur le comportement et les actes individuels.</p>\n</div></td><td>e410-e499</td><td>e435</td><td><code>http://id.who.int/icd/entity/1677739225</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1677739225</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1677739225</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1677739225/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e410-e499</td><td/><td>Individual attitudes of people in subordinate positions</td></tr><tr><td style=\"white-space:nowrap\">e210<a name=\"terminologie-icf-e210\"> </a></td><td>Caractéristiques physiques de la terre</td><td><div><p>Caractéristiques des paysages terrestres, aquatiques et marins.</p>\n</div></td><td>e210-e299</td><td>e210</td><td><code>http://id.who.int/icd/entity/915627353</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#915627353</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#915627353</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/915627353/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e210-e299</td><td>e2109, e2100, e2101, e2102, e2108</td><td>Physical features of the earth</td></tr><tr><td style=\"white-space:nowrap\">b1441<a name=\"terminologie-icf-b1441\"> </a></td><td>Mémoire à long terme</td><td><div><p>Fonctions mentales qui produisent un système mnémonique permettant le stockage à long terme d'informations à partir de la mémoire à court terme et à la fois la mémoire autobiographique des événements passés et la mémoire sémantique de la langue et des faits.</p>\n</div></td><td>b144</td><td>b1441</td><td><code>http://id.who.int/icd/entity/906623760</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#906623760</code>, <code>https://icd.who.int/browse/2026-01/icf/en#906623760</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/906623760/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b144</td><td/><td>Long-term memory</td></tr><tr><td style=\"white-space:nowrap\">b539<a name=\"terminologie-icf-b539\"> </a></td><td>Autres fonctions précisées et non précisées relatives au système digestif</td><td/><td>b510-b539</td><td>b539</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1976873960/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1976873960/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1976873960/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b510-b539</td><td/><td>Functions related to the digestive system, other specified and unspecified</td></tr><tr><td style=\"white-space:nowrap\">d1458<a name=\"terminologie-icf-d1458\"> </a></td><td>Apprendre à écrire, autres compétences précisées</td><td/><td>d145</td><td>d1458</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1725645062/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1725645062/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1725645062/other/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1725645062/other/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d145</td><td/><td>Other specified learning to write</td></tr><tr><td style=\"white-space:nowrap\">b4100<a name=\"terminologie-icf-b4100\"> </a></td><td>Fréquence cardiaque</td><td><div><p>Fonctions liées au nombre de contractions cardiaques par minute.</p>\n</div></td><td>b410</td><td>b4100</td><td><code>http://id.who.int/icd/entity/2100545361</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2100545361</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2100545361</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2100545361/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b410</td><td/><td>Heart rate</td></tr><tr><td style=\"white-space:nowrap\">s899<a name=\"terminologie-icf-s899\"> </a></td><td>Peau et structures annexes non précisées</td><td/><td>s810-s899</td><td>s899</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#84496745/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#84496745/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/84496745/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/84496745/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s810-s899</td><td/><td>Skin and related structures, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b798<a name=\"terminologie-icf-b798\"> </a></td><td>Autres fonctions précisées de l'appareil locomoteur et liées au mouvement</td><td/><td>b710-b799</td><td>b798</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#161488596/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#161488596/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/161488596/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b710-b799</td><td/><td>Other specified neuromusculoskeletal and movement-related functions</td></tr><tr><td style=\"white-space:nowrap\">d4503<a name=\"terminologie-icf-d4503\"> </a></td><td>Contourner les obstacles</td><td><div><p>Marcher de manière à éviter les objets mobiles ou immobiles, les personnes, les animaux et les véhicules, comme faire le tour d'un marché ou d'un magasin, se déplacer dans une rue où la circulation est dense ou dans d'autres lieux bondés.</p>\n</div></td><td>d450</td><td>d4503</td><td><code>http://id.who.int/icd/entity/409094401</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#409094401</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#409094401</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/409094401/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/409094401/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d450</td><td/><td>Walking around obstacles</td></tr><tr><td style=\"white-space:nowrap\">d649<a name=\"terminologie-icf-d649\"> </a></td><td>Autres tâches domestiques précisées et non précisées</td><td/><td>d630-d649</td><td>d649</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1452836727/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1452836727/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1452836727/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1452836727/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d630-d649</td><td/><td>Household tasks, other specified and unspecified</td></tr><tr><td style=\"white-space:nowrap\">e2250<a name=\"terminologie-icf-e2250\"> </a></td><td>Température</td><td><div><p>Niveau de chaud ou de froid, par exemple température élevée et ou basse, température normale ou extrême.</p>\n</div></td><td>e225</td><td>e2250</td><td><code>http://id.who.int/icd/entity/673614169</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#673614169</code>, <code>https://icd.who.int/browse/2026-01/icf/en#673614169</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/673614169/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e225</td><td/><td>Temperature</td></tr><tr><td style=\"white-space:nowrap\">s260<a name=\"terminologie-icf-s260\"> </a></td><td>Structure de l'oreille interne</td><td/><td>s210-s299</td><td>s260</td><td><code>http://id.who.int/icd/entity/426292658</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#426292658</code>, <code>https://icd.who.int/browse/2026-01/icf/en#426292658</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/426292658/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/426292658/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s210-s299</td><td>s2603, s2601, s2608, s2602, s2600, s2609</td><td>Structure of inner ear</td></tr><tr><td style=\"white-space:nowrap\">e135<a name=\"terminologie-icf-e135\"> </a></td><td>Produits et systèmes techniques pour l'emploi</td><td><div><p>Produits, équipements et systèmes techniques utilisés dans le monde du travail pour faciliter l'exécution des tâches.</p>\n</div></td><td>e110-e199</td><td>e135</td><td><code>http://id.who.int/icd/entity/1450609520</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1450609520</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1450609520</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1450609520/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e110-e199</td><td>e1358, e1351, e1359, e1350</td><td>Products and technology for employment</td></tr><tr><td style=\"white-space:nowrap\">s32021<a name=\"terminologie-icf-s32021\"> </a></td><td>Palais mou</td><td/><td>s3202</td><td>s32021</td><td><code>http://id.who.int/icd/entity/2134723000</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2134723000</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2134723000</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2134723000/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/2134723000/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s3202</td><td/><td>Soft palate</td></tr><tr><td style=\"white-space:nowrap\">d1451<a name=\"terminologie-icf-d1451\"> </a></td><td>Acquérir la compétence à écrire des symboles, des caractères et des lettres de l’alphabet</td><td><div><p>Apprendre les actions de base requises pour transposer un son (morphème) en un symbole ou un caractère (graphème).</p>\n</div></td><td>d145</td><td>d1451</td><td><code>http://id.who.int/icd/entity/1047450631</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1047450631</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1047450631</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1047450631/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1047450631/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d145</td><td/><td>Acquiring skills to write symbols, characters and alphabet letters</td></tr><tr><td style=\"white-space:nowrap\">d9202<a name=\"terminologie-icf-d9202\"> </a></td><td>Arts et culture</td><td><div><p>Pratiquer ou apprécier les beaux-arts et les manifestations culturelles, comme aller au théâtre, au cinéma, au musée ou dans une galerie d'art, jouer dans une pièce de théâtre, lire, se faire lire une histoire, danser, chanter ou jouer d'un instrument de musique pour le plaisir.</p>\n</div></td><td>d920</td><td>d9202</td><td><code>http://id.who.int/icd/entity/582699162</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#582699162</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#582699162</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/582699162/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/582699162/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d920</td><td/><td>Arts and culture</td></tr><tr><td style=\"white-space:nowrap\">b1142<a name=\"terminologie-icf-b1142\"> </a></td><td>Orientation par rapport à une personne</td><td><div><p>Fonctions mentales qui produisent la conscience de sa propre identité et des personnes vivant dans l'environnement immédiat.</p>\n</div></td><td>b114</td><td>b1142</td><td><code>http://id.who.int/icd/entity/1023908327</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1023908327</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1023908327</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1023908327/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b114</td><td>b11429, b11420, b11428, b11421</td><td>Orientation to person</td></tr><tr><td style=\"white-space:nowrap\">s11000<a name=\"terminologie-icf-s11000\"> </a></td><td>Lobe frontal</td><td/><td>s1100</td><td>s11000</td><td><code>http://id.who.int/icd/entity/885972928</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#885972928</code>, <code>https://icd.who.int/browse/2026-01/icf/en#885972928</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/885972928/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/885972928/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s1100</td><td/><td>Frontal lobe</td></tr><tr><td style=\"white-space:nowrap\">d1202<a name=\"terminologie-icf-d1202\"> </a></td><td>Sentir</td><td><div><p>Explorer des objets en les amenant vers le nez ou en portant le nez vers les objets.</p>\n</div></td><td>d120</td><td>d1202</td><td><code>http://id.who.int/icd/entity/789880946</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#789880946</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#789880946</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/789880946/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/789880946/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d120</td><td/><td>Smelling</td></tr><tr><td style=\"white-space:nowrap\">e5602<a name=\"terminologie-icf-e5602\"> </a></td><td>Politiques relatives aux médias</td><td><div><p>Textes de loi, réglementations et normes régissant la diffusion de nouvelles et autres informations vers le grand public, comme les politiques qui régissent le contenu, la distribution, la diffusion, l'accès à l'information et les méthodes de communications par la voie de la radio, de la télévision, des magazines, les journaux, les moyens de communications de masse informatisés (web, Internet).</p>\n</div></td><td>e560</td><td>e5602</td><td><code>http://id.who.int/icd/entity/1060577748</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1060577748</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1060577748</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1060577748/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e560</td><td/><td>Media policies</td></tr><tr><td style=\"white-space:nowrap\">e5400<a name=\"terminologie-icf-e5400\"> </a></td><td>Services relatifs aux transports</td><td><div><p>Services et programmes, y compris les personnes qui s'en occupent, visant à déplacer les personnes ou les biens par la route ou autre voie terrestre, par chemin de fer, par air ou par mer, qu'il s'agisse de moyens de transport publics ou privés.</p>\n</div></td><td>e540</td><td>e5400</td><td><code>http://id.who.int/icd/entity/70099773</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#70099773</code>, <code>https://icd.who.int/browse/2026-01/icf/en#70099773</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/70099773/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e540</td><td/><td>Transportation services</td></tr><tr><td style=\"white-space:nowrap\">e1450<a name=\"terminologie-icf-e1450\"> </a></td><td>Produits et systèmes techniques généraux pour la pratique religieuse et les activités spirituelles</td><td><div><p>Produits et systèmes techniques, uniques ou fabriqués en série, auxquels on accorde ou qui acquièrent une signification symbolique dans le cadre d'une pratique religieuse et d'activités spirituelles, comme des maisons d'esprits, mâts enrubannés, coiffes, masques, crucifix, menora et tapis de prière, et qui n'ont pas été adaptés ou spécialement conçus.</p>\n</div></td><td>e145</td><td>e1450</td><td><code>http://id.who.int/icd/entity/354833359</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#354833359</code>, <code>https://icd.who.int/browse/2026-01/icf/en#354833359</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/354833359/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e145</td><td/><td>General products and technology for the practice of religion or spirituality</td></tr><tr><td style=\"white-space:nowrap\">d6404<a name=\"terminologie-icf-d6404\"> </a></td><td>Entreposer les produits d'usage courant</td><td><div><p>Entreposer la nourriture, les boissons, le linge et autres objets ménagers nécessaires à la vie de tous les jours ; préparer la nourriture à garder en conserve, en salaison ou par réfrigération, garder la nourriture fraîche et hors de portée des animaux.</p>\n</div></td><td>d640</td><td>d6404</td><td><code>http://id.who.int/icd/entity/1714607124</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1714607124</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1714607124</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1714607124/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1714607124/postcoordinationScale/performance</code></td><td/><td/><td/><td>d640</td><td/><td>Storing daily necessities</td></tr><tr><td style=\"white-space:nowrap\">e5759<a name=\"terminologie-icf-e5759\"> </a></td><td>Services, systèmes et politiques non précisés relatifs aux services sociaux généraux</td><td/><td>e575</td><td>e5759</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#367297519/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#367297519/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/367297519/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e575</td><td/><td>General social support services, systems and policies, unspecified</td></tr><tr><td style=\"white-space:nowrap\">e5701<a name=\"terminologie-icf-e5701\"> </a></td><td>Systèmes relatifs à la sécurité sociale</td><td><div><p>Mécanismes de contrôle administratif et de surveillance qui régissent les programmes apportant un appui financier aux personnes qui, en raison de leur âge, de leurs moyens financiers, du chômage, de leur état de santé ou d'une incapacité, ont besoin d'assistance publique, comme les systèmes mettant en œuvre les réglementations définissant les règles d'admission aux bénéfices de l'assistance sociale, de l'assistance publique, de l'assurance chômage, et des indemnités pour invalidité et autres pensions associées.</p>\n</div></td><td>e570</td><td>e5701</td><td><code>http://id.who.int/icd/entity/514708987</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#514708987</code>, <code>https://icd.who.int/browse/2026-01/icf/en#514708987</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/514708987/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e570</td><td/><td>Social security systems</td></tr><tr><td style=\"white-space:nowrap\">d530<a name=\"terminologie-icf-d530\"> </a></td><td>Aller aux toilettes</td><td><div><p>Prévoir et réaliser l'élimination des déchets humains (menstruations, urine et selles) et se nettoyer par la suite.</p>\n</div></td><td>d510-d599</td><td>d530</td><td><code>http://id.who.int/icd/entity/1086994892</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1086994892</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1086994892</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1086994892/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1086994892/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d510-d599</td><td>d5300, d5302, d5309, d5308, d5301</td><td>Toileting</td></tr><tr><td style=\"white-space:nowrap\">e2509<a name=\"terminologie-icf-e2509\"> </a></td><td>Aspects relatifs au son non précisés</td><td/><td>e250</td><td>e2509</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1603650312/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1603650312/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1603650312/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e250</td><td/><td>Sound, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b6208<a name=\"terminologie-icf-b6208\"> </a></td><td>Autres fonctions urinaires précisées</td><td/><td>b620</td><td>b6208</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#244216203/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#244216203/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/244216203/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b620</td><td/><td>Other specified urination functions</td></tr><tr><td style=\"white-space:nowrap\">s3109<a name=\"terminologie-icf-s3109\"> </a></td><td>Structure non précisée du nez</td><td/><td>s310</td><td>s3109</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#814930862/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#814930862/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/814930862/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/814930862/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s310</td><td/><td>Structure of nose, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s3205<a name=\"terminologie-icf-s3205\"> </a></td><td>Philtrum</td><td/><td>s320</td><td>s3205</td><td><code>http://id.who.int/icd/entity/1939279566</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1939279566</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1939279566</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1939279566/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1939279566/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s320</td><td/><td>Philtrum</td></tr><tr><td style=\"white-space:nowrap\">d7504<a name=\"terminologie-icf-d7504\"> </a></td><td>Relations informelles avec ses pairs</td><td><div><p>Établir et entretenir des relations avec des personnes du même âge, ayant les mêmes intérêts ou présentant les mêmes caractéristiques.</p>\n</div></td><td>d750</td><td>d7504</td><td><code>http://id.who.int/icd/entity/2137354342</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2137354342</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2137354342</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2137354342/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/2137354342/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d750</td><td/><td>Informal relationships with peers</td></tr><tr><td style=\"white-space:nowrap\">d1601<a name=\"terminologie-icf-d1601\"> </a></td><td>Fixer son attention sur l’environnement</td><td><div><p>Prêter intentionnellement attention à certains éléments de l'environnement comme des changements de qualité, de quantité ou d’intensité des stimuli physiques ou sociaux.</p>\n</div></td><td>d160</td><td>d1601</td><td><code>http://id.who.int/icd/entity/1022925808</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1022925808</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1022925808</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1022925808/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1022925808/postcoordinationScale/performance</code></td><td/><td/><td/><td>d160</td><td/><td>Focusing attention on the environment</td></tr><tr><td style=\"white-space:nowrap\">b152<a name=\"terminologie-icf-b152\"> </a></td><td>Fonctions émotionnelles</td><td><div><p>Fonctions mentales spécifiques associées au sentiment et à la composante affective du processus mental.</p>\n</div></td><td>b140-b189</td><td>b152</td><td><code>http://id.who.int/icd/entity/668868854</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#668868854</code>, <code>https://icd.who.int/browse/2026-01/icf/en#668868854</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/668868854/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b140-b189</td><td>b1520, b1521, b1528, b1522, b1529</td><td>Emotional functions</td></tr><tr><td style=\"white-space:nowrap\">d770<a name=\"terminologie-icf-d770\"> </a></td><td>Relations intimes</td><td><div><p>Établir et entretenir des relations étroites ou amoureuses avec d'autres personnes, comme entre mari et femme, amants ou partenaires sexuels.</p>\n</div></td><td>d730-d779</td><td>d770</td><td><code>http://id.who.int/icd/entity/680339969</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#680339969</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#680339969</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/680339969/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/680339969/postcoordinationScale/performance</code></td><td/><td/><td/><td>d730-d779</td><td>d7701, d7700, d7702, d7708, d7709</td><td>Intimate relationships</td></tr><tr><td style=\"white-space:nowrap\">d540<a name=\"terminologie-icf-d540\"> </a></td><td>S'habiller</td><td><div><p>Effectuer les actions coordonnées et les tâches nécessaires pour mettre et ôter des vêtements et des chaussures dans l'ordre et en fonction du contexte social et du temps qu'il fait, par ex. en mettant, en ajustant et en enlevant une chemise, une jupe, une blouse, un pantalon, des sous-vêtements, un sari, un kimono, des collants, un chapeau, des gants, un manteau, des souliers, des bottes, des sandales et des pantoufles.</p>\n</div></td><td>d510-d599</td><td>d540</td><td><code>http://id.who.int/icd/entity/1860600370</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1860600370</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1860600370</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1860600370/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1860600370/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d510-d599</td><td>d5404, d5402, d5400, d5409, d5401, d5403, d5408</td><td>Dressing</td></tr><tr><td style=\"white-space:nowrap\">b598<a name=\"terminologie-icf-b598\"> </a></td><td>Autres fonctions précisées relatives aux systèmes digestif, métabolique et endocrinien</td><td/><td>b510-b599</td><td>b598</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#850289698/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#850289698/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/850289698/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b510-b599</td><td/><td>Other specified functions of the digestive, metabolic and endocrine systems</td></tr><tr><td style=\"white-space:nowrap\">b5352<a name=\"terminologie-icf-b5352\"> </a></td><td>Sensation de crampe abdominale</td><td><div><p>Sensation de contractions musculaires spasmodiques ou douloureuses des muscles lisses du tube digestif.</p>\n</div></td><td>b535</td><td>b5352</td><td><code>http://id.who.int/icd/entity/1346419749</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1346419749</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1346419749</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1346419749/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b535</td><td/><td>Sensation of abdominal cramp</td></tr><tr><td style=\"white-space:nowrap\">e5350<a name=\"terminologie-icf-e5350\"> </a></td><td>Services relatifs à la communication</td><td><div><p>Services et programmes, y compris les personnes qui s'en occupent, visant à la transmission de l'information par différents moyens comme le téléphone, la télécopie, le courrier, le courrier électronique et autres systèmes informatisés (services de relais téléphoniques, télétype, télétexte, services d'accès à internet).</p>\n</div></td><td>e535</td><td>e5350</td><td><code>http://id.who.int/icd/entity/885859171</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#885859171</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#885859171</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/885859171/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e535</td><td/><td>Communication services</td></tr><tr><td style=\"white-space:nowrap\">b3303<a name=\"terminologie-icf-b3303\"> </a></td><td>Mélodie de la parole</td><td><div><p>Fonctions relatives à la modulation du timbre dans le discours.</p>\n</div></td><td>b330</td><td>b3303</td><td><code>http://id.who.int/icd/entity/1426641453</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1426641453</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1426641453</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1426641453/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b330</td><td/><td>Melody of speech</td></tr><tr><td style=\"white-space:nowrap\">s8301<a name=\"terminologie-icf-s8301\"> </a></td><td>Ongles d'orteil</td><td/><td>s830</td><td>s8301</td><td><code>http://id.who.int/icd/entity/950348650</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#950348650</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#950348650</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/950348650/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/950348650/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s830</td><td/><td>Toe nails</td></tr><tr><td style=\"white-space:nowrap\">s7403<a name=\"terminologie-icf-s7403\"> </a></td><td>Ligaments et fascia de la région pelvienne</td><td/><td>s740</td><td>s7403</td><td><code>http://id.who.int/icd/entity/946830731</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#946830731</code>, <code>https://icd.who.int/browse/2026-01/icf/en#946830731</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/946830731/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/946830731/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s740</td><td/><td>Ligaments and fasciae of pelvic region</td></tr><tr><td style=\"white-space:nowrap\">d7501<a name=\"terminologie-icf-d7501\"> </a></td><td>Relations informelles avec des voisins</td><td><div><p>Établir et entretenir des relations avec des personnes vivant à proximité.</p>\n</div></td><td>d750</td><td>d7501</td><td><code>http://id.who.int/icd/entity/887916454</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#887916454</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#887916454</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/887916454/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/887916454/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d750</td><td/><td>Informal relationships with neighbours</td></tr><tr><td style=\"white-space:nowrap\">d750<a name=\"terminologie-icf-d750\"> </a></td><td>Relations sociales informelles</td><td><div><p>Engager des relations avec autrui, comme des relations informelles avec des personnes du voisinage ou de la même résidence, ou avec des collègues de travail, des étudiants, des compagnons de jeux, des personnes ayant les mêmes affinités ou la même profession.</p>\n</div></td><td>d730-d779</td><td>d750</td><td><code>http://id.who.int/icd/entity/1817637292</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1817637292</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1817637292</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1817637292/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1817637292/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d730-d779</td><td>d7502, d7500, d7504, d7501, d7503, d7509, d7508</td><td>Informal social relationships</td></tr><tr><td style=\"white-space:nowrap\">b1643<a name=\"terminologie-icf-b1643\"> </a></td><td>Flexibilité cognitive</td><td><div><p>Fonctions mentales permettant de changer de stratégie ou de passer d'une disposition mentale à une autre, particulièrement dans le cadre de la résolution de problèmes.</p>\n</div></td><td>b164</td><td>b1643</td><td><code>http://id.who.int/icd/entity/219380223</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#219380223</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#219380223</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/219380223/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b164</td><td/><td>Cognitive flexibility</td></tr><tr><td style=\"white-space:nowrap\">b16718<a name=\"terminologie-icf-b16718\"> </a></td><td>Autres expressions précisées du langage</td><td/><td>b1671</td><td>b16718</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2069698903/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2069698903/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2069698903/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b1671</td><td/><td>Other specified expression of language</td></tr><tr><td style=\"white-space:nowrap\">s110<a name=\"terminologie-icf-s110\"> </a></td><td>Structure du cerveau</td><td/><td>s110-s199</td><td>s110</td><td><code>http://id.who.int/icd/entity/634949825</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#634949825</code>, <code>https://icd.who.int/browse/2026-01/icf/en#634949825</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/634949825/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/634949825/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s110-s199</td><td>s1103, s1100, s1105, s1109, s1104, s1106, s1108, s1102, s1101</td><td>Structure of brain</td></tr><tr><td style=\"white-space:nowrap\">b525<a name=\"terminologie-icf-b525\"> </a></td><td>Fonctions de défécation</td><td><div><p>Fonctions d'élimination des déchets et des aliments non digérés en matières fécales et fonctions connexes.</p>\n</div></td><td>b510-b539</td><td>b525</td><td><code>http://id.who.int/icd/entity/103904314</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#103904314</code>, <code>https://icd.who.int/browse/2026-01/icf/en#103904314</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/103904314/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b510-b539</td><td>b5253, b5250, b5258, b5252, b5254, b5259, b5251</td><td>Defecation functions</td></tr><tr><td style=\"white-space:nowrap\">d3151<a name=\"terminologie-icf-d3151\"> </a></td><td>Communiquer - recevoir des signes et des symboles généraux</td><td><div><p>Comprendre la signification des signes et symboles publics, comme les panneaux routiers, les symboles de mise en garde, les notations (par exemple musicale ou scientifique) et les signalisations.</p>\n</div></td><td>d315</td><td>d3151</td><td><code>http://id.who.int/icd/entity/259252620</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#259252620</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#259252620</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/259252620/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/259252620/postcoordinationScale/performance</code></td><td/><td/><td/><td>d315</td><td/><td>Communicating with - receiving - general signs and symbols</td></tr><tr><td style=\"white-space:nowrap\">b1479<a name=\"terminologie-icf-b1479\"> </a></td><td>Fonctions psychomotrices non précisées</td><td/><td>b147</td><td>b1479</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1295484620/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1295484620/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1295484620/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b147</td><td/><td>Psychomotor functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">e5251<a name=\"terminologie-icf-e5251\"> </a></td><td>Systèmes relatifs au logement</td><td><div><p>Mécanismes de contrôle administratif et de surveillance qui régissent l'habitat et le logement, comme les systèmes mis en place pour faire exécuter et suivre les politiques en matière de logement.</p>\n</div></td><td>e525</td><td>e5251</td><td><code>http://id.who.int/icd/entity/990322378</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#990322378</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#990322378</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/990322378/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e525</td><td/><td>Housing systems</td></tr><tr><td style=\"white-space:nowrap\">b7502<a name=\"terminologie-icf-b7502\"> </a></td><td>Réflexes provoqués par d'autres stimuli extéroceptifs</td><td><div><p>Fonctions des contractions involontaires des muscles automatiquement provoquées par des stimuli externes autres que nocifs.</p>\n</div></td><td>b750</td><td>b7502</td><td><code>http://id.who.int/icd/entity/2066325290</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2066325290</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2066325290</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2066325290/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b750</td><td/><td>Reflexes generated by other exteroceptive stimuli</td></tr><tr><td style=\"white-space:nowrap\">s4101<a name=\"terminologie-icf-s4101\"> </a></td><td>Artères</td><td/><td>s410</td><td>s4101</td><td><code>http://id.who.int/icd/entity/647462043</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#647462043</code>, <code>https://icd.who.int/browse/2026-01/icf/en#647462043</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/647462043/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/647462043/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s410</td><td/><td>Arteries</td></tr><tr><td style=\"white-space:nowrap\">d4408<a name=\"terminologie-icf-d4408\"> </a></td><td>Autres activités précisées de motricité fine</td><td/><td>d440</td><td>d4408</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#522484083/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#522484083/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/522484083/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/522484083/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d440</td><td/><td>Other specified fine hand use</td></tr><tr><td style=\"white-space:nowrap\">d4501<a name=\"terminologie-icf-d4501\"> </a></td><td>Marcher sur de longues distances</td><td><div><p>Avancer à pied, sur une distance de plus d'un kilomètre, comme marcher d'un bout à l'autre du village ou de la ville, d'un village à l'autre ou dans la campagne.</p>\n</div></td><td>d450</td><td>d4501</td><td><code>http://id.who.int/icd/entity/909279361</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#909279361</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#909279361</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/909279361/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/909279361/postcoordinationScale/performance</code></td><td/><td/><td/><td>d450</td><td/><td>Walking long distances</td></tr><tr><td style=\"white-space:nowrap\">b810-b849<a name=\"terminologie-icf-b810-b849\"> </a></td><td>Fonctions de la peau</td><td/><td>b810-b899</td><td/><td><code>http://id.who.int/icd/entity/1382522180</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1382522180</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1382522180</code></td><td/><td>BlockL3-b81</td><td>b810-b849</td><td/><td>b810-b899</td><td>b830, b840, b810, b820, b849</td><td>Functions of the skin</td></tr><tr><td style=\"white-space:nowrap\">b16712<a name=\"terminologie-icf-b16712\"> </a></td><td>Expression de la langue des signes</td><td><div><p>Fonctions mentales nécessaires à la production de messages signifiants exprimés dans un langage utilisant les signes des mains et d'autres mouvements.</p>\n</div></td><td>b1671</td><td>b16712</td><td><code>http://id.who.int/icd/entity/1410166737</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1410166737</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1410166737</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1410166737/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b1671</td><td/><td>Expression of sign language</td></tr><tr><td style=\"white-space:nowrap\">s3301<a name=\"terminologie-icf-s3301\"> </a></td><td>Pharynx buccal</td><td/><td>s330</td><td>s3301</td><td><code>http://id.who.int/icd/entity/936690855</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#936690855</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#936690855</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/936690855/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/936690855/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s330</td><td/><td>Oral pharynx</td></tr><tr><td style=\"white-space:nowrap\">s3102<a name=\"terminologie-icf-s3102\"> </a></td><td>Fosses nasales</td><td/><td>s310</td><td>s3102</td><td><code>http://id.who.int/icd/entity/468066954</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#468066954</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#468066954</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/468066954/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/468066954/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s310</td><td/><td>Nasal fossae</td></tr><tr><td style=\"white-space:nowrap\">b51059<a name=\"terminologie-icf-b51059\"> </a></td><td>Fonctions de déglutition non précisées</td><td/><td>b5105</td><td>b51059</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#923782542/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#923782542/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/923782542/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b5105</td><td/><td>Swallowing, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b5158<a name=\"terminologie-icf-b5158\"> </a></td><td>Autres fonctions digestives précisées</td><td/><td>b515</td><td>b5158</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1580195090/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1580195090/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1580195090/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b515</td><td/><td>Other specified digestive functions</td></tr><tr><td style=\"white-space:nowrap\">e355<a name=\"terminologie-icf-e355\"> </a></td><td>Professionnels de santé</td><td><div><p>Tous les prestataires de soins travaillant dans le cadre du système de santé, comme les médecins, infirmières, physiothérapeutes, ergothérapeutes, logopèdes, audiométriciens, prothésistes, travailleurs médico-sociaux, et autres fournisseurs de soins.</p>\n</div></td><td>e310-e399</td><td>e355</td><td><code>http://id.who.int/icd/entity/218000815</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#218000815</code>, <code>https://icd.who.int/browse/2026-01/icf/en#218000815</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/218000815/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e310-e399</td><td/><td>Health professionals</td></tr><tr><td style=\"white-space:nowrap\">b1649<a name=\"terminologie-icf-b1649\"> </a></td><td>Fonctions cognitives non précisées de niveau supérieur</td><td/><td>b164</td><td>b1649</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1384847483/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1384847483/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1384847483/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b164</td><td/><td>Higher-level cognitive functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s73000<a name=\"terminologie-icf-s73000\"> </a></td><td>Os du bras</td><td/><td>s7300</td><td>s73000</td><td><code>http://id.who.int/icd/entity/1092128842</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1092128842</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1092128842</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1092128842/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1092128842/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s7300</td><td/><td>Bones of upper arm</td></tr><tr><td style=\"white-space:nowrap\">d7400<a name=\"terminologie-icf-d7400\"> </a></td><td>Relations avec des personnes ayant autorité</td><td><div><p>Établir et entretenir des relations spécifiques avec des personnes en position de pouvoir, ou jouissant d'un rang ou d'un prestige plus élevé par rapport à sa propre position sociale, comme un employeur.</p>\n</div></td><td>d740</td><td>d7400</td><td><code>http://id.who.int/icd/entity/992393743</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#992393743</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#992393743</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/992393743/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/992393743/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d740</td><td/><td>Relating with persons in authority</td></tr><tr><td style=\"white-space:nowrap\">d8709<a name=\"terminologie-icf-d8709\"> </a></td><td>Domaines non précisés d'autosuffisance économique</td><td/><td>d870</td><td>d8709</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#948398905/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#948398905/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/948398905/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/948398905/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d870</td><td/><td>Economic self-sufficiency, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d175<a name=\"terminologie-icf-d175\"> </a></td><td>Résoudre des problèmes</td><td><div><p>Trouver la réponse à des questions ou la solution à des situations en cernant et en analysant les questions qui se posent, en mettant au point des options ou des solutions, et en évaluant les effets potentiels de ces solutions, par ex. en résolvant une dispute entre deux personnes.</p>\n</div></td><td>d160-d179</td><td>d175</td><td><code>http://id.who.int/icd/entity/126518990</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#126518990</code>, <code>https://icd.who.int/browse/2026-01/icf/en#126518990</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/126518990/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/126518990/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d160-d179</td><td>d1759, d1751, d1750, d1758</td><td>Solving problems</td></tr><tr><td style=\"white-space:nowrap\">b6200<a name=\"terminologie-icf-b6200\"> </a></td><td>Miction</td><td><div><p>Fonctions de vider la vessie.</p>\n</div></td><td>b620</td><td>b6200</td><td><code>http://id.who.int/icd/entity/1945120621</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1945120621</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1945120621</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1945120621/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b620</td><td/><td>Urination</td></tr><tr><td style=\"white-space:nowrap\">e2255<a name=\"terminologie-icf-e2255\"> </a></td><td>Variations saisonnières</td><td><div><p>Changements naturels, réguliers et prévisibles accompagnant le passage d'une saison à l'autre (été, automne, hiver, printemps).</p>\n</div></td><td>e225</td><td>e2255</td><td><code>http://id.who.int/icd/entity/1672445593</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1672445593</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1672445593</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1672445593/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e225</td><td/><td>Seasonal variation</td></tr><tr><td style=\"white-space:nowrap\">d610-d629<a name=\"terminologie-icf-d610-d629\"> </a></td><td>Acquérir des produits d'usage courant</td><td/><td>d610-d699</td><td/><td><code>http://id.who.int/icd/entity/1348372661</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1348372661</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1348372661</code></td><td/><td>BlockL3-d61</td><td>d610-d629</td><td/><td>d610-d699</td><td>d610, d620, d629</td><td>Acquisition of necessities</td></tr><tr><td style=\"white-space:nowrap\">d4552<a name=\"terminologie-icf-d4552\"> </a></td><td>Courir</td><td><div><p>Se mouvoir d'un pas rapide, de telle manière que les deux pieds puissent être en l'air en même temps.</p>\n</div></td><td>d455</td><td>d4552</td><td><code>http://id.who.int/icd/entity/412494151</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#412494151</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#412494151</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/412494151/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/412494151/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d455</td><td/><td>Running</td></tr><tr><td style=\"white-space:nowrap\">e1603<a name=\"terminologie-icf-e1603\"> </a></td><td>Produits et systèmes techniques des parcs, des zones protégées et des réserves naturelles</td><td><div><p>Produits et systèmes techniques des terrains aménagés en parcs, zones protégées et réserves naturelles et qui constituent l'environnement immédiat d'un individu qui ont été affectés ou changés par les politiques, la conception, la planification et l'aménagement du territoire, comme le balisage des sentiers et des pistes d'animaux.</p>\n</div></td><td>e160</td><td>e1603</td><td><code>http://id.who.int/icd/entity/784904552</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#784904552</code>, <code>https://icd.who.int/browse/2026-01/icf/en#784904552</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/784904552/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e160</td><td/><td>Products and technology of parks, conservation and wildlife areas</td></tr><tr><td style=\"white-space:nowrap\">d110<a name=\"terminologie-icf-d110\"> </a></td><td>Regarder</td><td><div><p>Utiliser les organes des sens intentionnellement pour percevoir des stimuli visuels, comme suivre un objet des yeux, regarder un événement sportif, regarder des personnes ou des enfants jouer.</p>\n</div></td><td>d110-d129</td><td>d110</td><td><code>http://id.who.int/icd/entity/982430274</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#982430274</code>, <code>https://icd.who.int/browse/2026-01/icf/en#982430274</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/982430274/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/982430274/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d110-d129</td><td/><td>Watching</td></tr><tr><td style=\"white-space:nowrap\">s8402<a name=\"terminologie-icf-s8402\"> </a></td><td>Poils axillaires</td><td/><td>s840</td><td>s8402</td><td><code>http://id.who.int/icd/entity/652280560</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#652280560</code>, <code>https://icd.who.int/browse/2026-01/icf/en#652280560</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/652280560/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/652280560/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s840</td><td/><td>Axillary hair</td></tr><tr><td style=\"white-space:nowrap\">d3608<a name=\"terminologie-icf-d3608\"> </a></td><td>Utiliser d'autres appareils et techniques de communication précisés</td><td/><td>d360</td><td>d3608</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#517787226/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#517787226/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/517787226/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/517787226/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d360</td><td/><td>Other specified using communication devices and techniques</td></tr><tr><td style=\"white-space:nowrap\">d4109<a name=\"terminologie-icf-d4109\"> </a></td><td>Changements non précisés de la position du corps</td><td/><td>d410</td><td>d4109</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#150502901/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#150502901/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/150502901/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/150502901/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d410</td><td/><td>Changing basic body position, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d1558<a name=\"terminologie-icf-d1558\"> </a></td><td>Acquérir d'autres savoir-faire précisés</td><td/><td>d155</td><td>d1558</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#402775005/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#402775005/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/402775005/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/402775005/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d155</td><td/><td>Other specified acquiring skills</td></tr><tr><td style=\"white-space:nowrap\">b1564<a name=\"terminologie-icf-b1564\"> </a></td><td>Perception tactile</td><td><div><p>Fonctions mentales impliquées dans la distinction des différences dans la texture, tels que les stimuli rudes ou doux, perçus par le toucher.</p>\n</div></td><td>b156</td><td>b1564</td><td><code>http://id.who.int/icd/entity/1134978632</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1134978632</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1134978632</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1134978632/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b156</td><td/><td>Tactile perception</td></tr><tr><td style=\"white-space:nowrap\">s5401<a name=\"terminologie-icf-s5401\"> </a></td><td>Gros intestin</td><td/><td>s540</td><td>s5401</td><td><code>http://id.who.int/icd/entity/357846577</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#357846577</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#357846577</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/357846577/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/357846577/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s540</td><td/><td>Large intestine</td></tr><tr><td style=\"white-space:nowrap\">b7809<a name=\"terminologie-icf-b7809\"> </a></td><td>Sensations non précisées relatives aux muscles et aux fonctions motrices</td><td/><td>b780</td><td>b7809</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1405368356/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1405368356/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1405368356/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b780</td><td/><td>Sensations related to muscles and movement functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b210-b229<a name=\"terminologie-icf-b210-b229\"> </a></td><td>Fonctions visuelles et fonctions connexes</td><td/><td>b210-b299</td><td/><td><code>http://id.who.int/icd/entity/890173921</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#890173921</code>, <code>https://icd.who.int/browse/2026-01/icf/en#890173921</code></td><td/><td>BlockL3-b21</td><td>b210-b229</td><td/><td>b210-b299</td><td>b210, b215, b220, b229</td><td>Seeing and related functions</td></tr><tr><td style=\"white-space:nowrap\">e5852<a name=\"terminologie-icf-e5852\"> </a></td><td>Politiques relatives à l'éducation et à la formation</td><td><div><p>Textes de loi, réglementations et normes régissant la mise en place des services d'éducation, comme les mécanismes permettant de mettre en œuvre les normes et politiques qui définissent les conditions d'accès à l'enseignement public et privé et aux programmes d'enseignement spécialisé, et organisent les conseils locaux, régionaux et nationaux de l'enseignement et autres autorités de tutelle chargés de déterminer les caractéristiques du système scolaire, y compris les programmes de cours, la taille des classes, le nombre d'écoles par région, les droits d'inscriptions et les subsides accordés, le régime des cantines scolaires et les services de garderie après l'école.</p>\n</div></td><td>e585</td><td>e5852</td><td><code>http://id.who.int/icd/entity/1109185881</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1109185881</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1109185881</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1109185881/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e585</td><td/><td>Education and training policies</td></tr><tr><td style=\"white-space:nowrap\">s2208<a name=\"terminologie-icf-s2208\"> </a></td><td>Autre structure précisée du globe oculaire</td><td/><td>s220</td><td>s2208</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1886268399/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1886268399/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1886268399/other/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1886268399/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s220</td><td/><td>Other specified structure of eyeball</td></tr><tr><td style=\"white-space:nowrap\">d6601<a name=\"terminologie-icf-d6601\"> </a></td><td>Aider les autres à se déplacer</td><td><div><p>Aider les membres du ménage et les autres à se déplacer à l'extérieur de la maison, dans le voisinage ou en ville, pour aller à l'école, au travail ou vers toute autre destination et en revenir.</p>\n</div></td><td>d660</td><td>d6601</td><td><code>http://id.who.int/icd/entity/955345085</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#955345085</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#955345085</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/955345085/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/955345085/postcoordinationScale/performance</code></td><td/><td/><td/><td>d660</td><td/><td>Assisting others in movement</td></tr><tr><td style=\"white-space:nowrap\">b7150<a name=\"terminologie-icf-b7150\"> </a></td><td>Stabilité d'une seule articulation</td><td><div><p>Fonctions relatives au maintien de l'intégrité structurelle d'une articulation.</p>\n</div></td><td>b715</td><td>b7150</td><td><code>http://id.who.int/icd/entity/1748092144</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1748092144</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1748092144</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1748092144/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b715</td><td/><td>Stability of a single joint</td></tr><tr><td style=\"white-space:nowrap\">e345<a name=\"terminologie-icf-e345\"> </a></td><td>Personne inconnues</td><td><div><p>Personnes qui ne sont ni des familiers ni des personnes apparentées, ou qui n'ont pas encore établi une relation ou se sont associées avec la personne concernée, y compris les personnes inconnues qui vivent dans une situation identique, par exemple un professeur suppléant, un collègue, un prestataire de soins.</p>\n</div></td><td>e310-e399</td><td>e345</td><td><code>http://id.who.int/icd/entity/1915025272</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1915025272</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1915025272</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1915025272/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e310-e399</td><td/><td>Strangers</td></tr><tr><td style=\"white-space:nowrap\">qm8<a name=\"terminologie-icf-qm8\"> </a></td><td>sans objet</td><td/><td>qm0-qm9</td><td>qm8</td><td><code>http://id.who.int/icd/entity/1702287930</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1702287930</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1702287930</code></td><td/><td/><td/><td/><td>qm0-qm9</td><td/><td>not applicable</td></tr><tr><td style=\"white-space:nowrap\">b761<a name=\"terminologie-icf-b761\"> </a></td><td>Mouvements spontanés</td><td><div><p>Fonctions associées à la fréquence, à la fluidité et à la complexité des mouvements de l'ensemble du corps ou des parties du corps tels que les mouvements spontanés du nourrisson ou les mouvements types.</p>\n</div></td><td>b750-b789</td><td>b761</td><td><code>http://id.who.int/icd/entity/651964938</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#651964938</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#651964938</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/651964938/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td>Ce code ne doit être utilisé que pour les nourrissons âgés de moins de 6 mois en âge corrigé. [possible translation], This code should be applied only to infants aged less than corrected age 6 months.</td><td>b750-b789</td><td>b7611, b7610, b7619, b7618</td><td>Spontaneous movements</td></tr><tr><td style=\"white-space:nowrap\">e1601<a name=\"terminologie-icf-e1601\"> </a></td><td>Produits et systèmes techniques de l'aménagement des espaces suburbains</td><td><div><p>Produits et systèmes techniques des zones suburbaines qui constituent l'environnement immédiat d'une personne et qui ont été affectés ou changés par les politiques, la conception, la planification et l'aménagement du territoire, comme les bateaux de portes, les passages, les panneaux indicateurs et l'éclairage public.</p>\n</div></td><td>e160</td><td>e1601</td><td><code>http://id.who.int/icd/entity/9992424</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#9992424</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#9992424</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/9992424/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e160</td><td/><td>Products and technology of suburban land development</td></tr><tr><td style=\"white-space:nowrap\">e2608<a name=\"terminologie-icf-e2608\"> </a></td><td>Autres caractéristiques précisées de qualité de l'air</td><td/><td>e260</td><td>e2608</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#126577200/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#126577200/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/126577200/other/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e260</td><td/><td>Other specified air quality</td></tr><tr><td style=\"white-space:nowrap\">d430-d449<a name=\"terminologie-icf-d430-d449\"> </a></td><td>Porter, déplacer et manipuler des objets</td><td/><td>d410-d499</td><td/><td><code>http://id.who.int/icd/entity/2086581809</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2086581809</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2086581809</code></td><td/><td>BlockL3-d43</td><td>d430-d449</td><td/><td>d410-d499</td><td>d435, d430, d440, d445, d449, d446</td><td>Carrying, moving and handling objects</td></tr><tr><td style=\"white-space:nowrap\">d840-d859<a name=\"terminologie-icf-d840-d859\"> </a></td><td>Travail et emploi</td><td/><td>d810-d899</td><td/><td><code>http://id.who.int/icd/entity/73014515</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#73014515</code>, <code>https://icd.who.int/browse/2026-01/icf/en#73014515</code></td><td/><td>BlockL3-d84</td><td>d840-d859</td><td/><td>d810-d899</td><td>d859, d855, d850, d845, d840</td><td>Work and employment</td></tr><tr><td style=\"white-space:nowrap\">s7209<a name=\"terminologie-icf-s7209\"> </a></td><td>Structure non précisée de la région des épaules</td><td/><td>s720</td><td>s7209</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1108927576/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1108927576/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1108927576/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1108927576/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s720</td><td/><td>Structure of shoulder region, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d4308<a name=\"terminologie-icf-d4308\"> </a></td><td>Autres activités précisées relatives au fait de soulever et porter</td><td/><td>d430</td><td>d4308</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#775704068/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#775704068/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/775704068/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/775704068/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d430</td><td/><td>Lifting and carrying, other specified</td></tr><tr><td style=\"white-space:nowrap\">e580<a name=\"terminologie-icf-e580\"> </a></td><td>Services, systèmes et politiques relatifs à la santé</td><td><div><p>Services, systèmes et politiques visant à prévenir et traiter les problèmes de santé, assurer la réadaptation médicale et promouvoir des modes de vie sains.</p>\n</div></td><td>e510-e599</td><td>e580</td><td><code>http://id.who.int/icd/entity/1116176408</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1116176408</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1116176408</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1116176408/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e510-e599</td><td>e5800, e5808, e5809, e5801, e5802</td><td>Health services, systems and policies</td></tr><tr><td style=\"white-space:nowrap\">e1651<a name=\"terminologie-icf-e1651\"> </a></td><td>Produits et biens matériels</td><td><div><p>Produits et objets, comme un bien immobilier, des vêtements, de la nourriture et des biens techniques, qui servent de moyens d'échanges pour le travail, les biens et les services.</p>\n</div></td><td>e165</td><td>e1651</td><td><code>http://id.who.int/icd/entity/390364256</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#390364256</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#390364256</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/390364256/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e165</td><td/><td>Tangible assets</td></tr><tr><td style=\"white-space:nowrap\">e498<a name=\"terminologie-icf-e498\"> </a></td><td>Autres attitudes précisées</td><td/><td>e410-e499</td><td>e498</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#800966918/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#800966918/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/800966918/other/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e410-e499</td><td/><td>Other specified attitudes</td></tr><tr><td style=\"white-space:nowrap\">d7106<a name=\"terminologie-icf-d7106\"> </a></td><td>Différencier les personnes familières</td><td><div><p>Réagir de manière différenciée vis-à-vis des individus, comme tendre les bras vers une personne familière en la différenciant des personnes que l'on ne connaît pas et réagir de manière appropriée.</p>\n</div></td><td>d710</td><td>d7106</td><td><code>http://id.who.int/icd/entity/2074160952</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2074160952</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2074160952</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2074160952/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/2074160952/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d710</td><td/><td>Differentiation of familiar persons</td></tr><tr><td style=\"white-space:nowrap\">b869<a name=\"terminologie-icf-b869\"> </a></td><td>Autres fonctions précisées et non précisées relatives aux cheveux, aux poils et aux ongles</td><td/><td>b850-b869</td><td>b869</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#425006483/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#425006483/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/425006483/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b850-b869</td><td/><td>Functions of the hair and nails, other specified and unspecified</td></tr><tr><td style=\"white-space:nowrap\">e5502<a name=\"terminologie-icf-e5502\"> </a></td><td>Politiques relatives au droit</td><td><div><p>Textes de loi, réglementations et normes régissant l'administration de la justice, comme les lois, jurisprudences, lois religieuses, lois et conventions internationales.</p>\n</div></td><td>e550</td><td>e5502</td><td><code>http://id.who.int/icd/entity/849294292</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#849294292</code>, <code>https://icd.who.int/browse/2026-01/icf/en#849294292</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/849294292/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e550</td><td/><td>Legal policies</td></tr><tr><td style=\"white-space:nowrap\">d3502<a name=\"terminologie-icf-d3502\"> </a></td><td>Mettre fin à une conversation</td><td><div><p>Mettre fin à un dialogue ou un échange en ayant recours aux formules usuelles et en mettant un point final aux discussions sur le sujet abordé.</p>\n</div></td><td>d350</td><td>d3502</td><td><code>http://id.who.int/icd/entity/188997266</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#188997266</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#188997266</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/188997266/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/188997266/postcoordinationScale/performance</code></td><td/><td/><td/><td>d350</td><td/><td>Ending a conversation</td></tr><tr><td style=\"white-space:nowrap\">b1342<a name=\"terminologie-icf-b1342\"> </a></td><td>Maintien du sommeil</td><td><div><p>Fonctions mentales qui maintiennent l'état de sommeil.</p>\n</div></td><td>b134</td><td>b1342</td><td><code>http://id.who.int/icd/entity/676188810</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#676188810</code>, <code>https://icd.who.int/browse/2026-01/icf/en#676188810</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/676188810/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b134</td><td/><td>Maintenance of sleep</td></tr><tr><td style=\"white-space:nowrap\">e2609<a name=\"terminologie-icf-e2609\"> </a></td><td>Caractéristiques non précisées de qualité de l'air</td><td/><td>e260</td><td>e2609</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#126577200/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#126577200/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/126577200/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e260</td><td/><td>Air quality, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b4400<a name=\"terminologie-icf-b4400\"> </a></td><td>Fréquence respiratoire</td><td><div><p>Fonctions liées au nombre de respirations par minute.</p>\n</div></td><td>b440</td><td>b4400</td><td><code>http://id.who.int/icd/entity/1329924326</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1329924326</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1329924326</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1329924326/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b440</td><td/><td>Respiration rate</td></tr><tr><td style=\"white-space:nowrap\">b1641<a name=\"terminologie-icf-b1641\"> </a></td><td>Organisation et planification</td><td><div><p>Fonctions mentales permettant de coordonner les parties en un tout, de systématiser ; la fonction mentale impliquée dans le développement d'une méthode pour procéder à quelque chose ou pour agir.</p>\n</div></td><td>b164</td><td>b1641</td><td><code>http://id.who.int/icd/entity/591638655</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#591638655</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#591638655</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/591638655/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b164</td><td/><td>Organization and planning</td></tr><tr><td style=\"white-space:nowrap\">b164<a name=\"terminologie-icf-b164\"> </a></td><td>Fonctions cognitives de niveau supérieur</td><td><div><p>Fonctions mentales spécifiques dépendant des lobes frontaux du cerveau, y compris les comportements centrés sur un objectif comme dans la prise de décision, l'abstraction de la pensée, la préparation et l'exécution de plans, la flexibilité mentale, et le choix des comportements en fonction des circonstances ; fonctions souvent appelées exécutives.</p>\n</div></td><td>b140-b189</td><td>b164</td><td><code>http://id.who.int/icd/entity/1384847483</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1384847483</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1384847483</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1384847483/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b140-b189</td><td>b1645, b1643, b1649, b1648, b1646, b1641, b1640, b1644, b1642</td><td>Higher-level cognitive functions</td></tr><tr><td style=\"white-space:nowrap\">b126<a name=\"terminologie-icf-b126\"> </a></td><td>Fonctions du tempérament et de la personnalité</td><td><div><p>Fonctions mentales générales du caractère constitutionnel de l'individu qui le font réagir d'une certaine manière à des situations, y compris l'ensemble des caractéristiques mentales qui distinguent l'individu des autres.</p>\n</div></td><td>b110-b139</td><td>b126</td><td><code>http://id.who.int/icd/entity/366825380</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#366825380</code>, <code>https://icd.who.int/browse/2026-01/icf/en#366825380</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/366825380/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b110-b139</td><td>b1264, b1268, b1262, b1260, b1261, b1269, b1263, b1267, b1266, b1265</td><td>Temperament and personality functions</td></tr><tr><td style=\"white-space:nowrap\">qs0-qs9<a name=\"terminologie-icf-qs0-qs9\"> </a></td><td>Nature de la déficience</td><td/><td><code>http://id.who.int/icd/release/11/2026-01/icf/423829389</code></td><td/><td><code>http://id.who.int/icd/entity/524499668</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#524499668</code>, <code>https://icd.who.int/browse/2026-01/icf/en#524499668</code></td><td/><td/><td>qs0-qs9</td><td/><td/><td>qs3, qs4, qs1, qs6, qs9, qs2, qs0, qs8, qs7, qs5</td><td>Nature of change in body structure</td></tr><tr><td style=\"white-space:nowrap\">s7308<a name=\"terminologie-icf-s7308\"> </a></td><td>Autre structure précisée du membre supérieur</td><td/><td>s730</td><td>s7308</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1019379329/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1019379329/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1019379329/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1019379329/other/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s730</td><td/><td>Other specified structure of upper extremity</td></tr><tr><td style=\"white-space:nowrap\">d7102<a name=\"terminologie-icf-d7102\"> </a></td><td>Tolérance</td><td><div><p>Faire preuve de, et réagir aux marques de, compréhension et d'acceptation de certains comportements en fonction de diverses situations et dans le respect des convenances.</p>\n</div></td><td>d710</td><td>d7102</td><td><code>http://id.who.int/icd/entity/654359608</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#654359608</code>, <code>https://icd.who.int/browse/2026-01/icf/en#654359608</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/654359608/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/654359608/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d710</td><td/><td>Tolerance in relationships</td></tr><tr><td style=\"white-space:nowrap\">b1108<a name=\"terminologie-icf-b1108\"> </a></td><td>Autres fonctions précisées de la conscience</td><td/><td>b110</td><td>b1108</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1060289548/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1060289548/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1060289548/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b110</td><td/><td>Other specified consciousness functions</td></tr><tr><td style=\"white-space:nowrap\">d210<a name=\"terminologie-icf-d210\"> </a></td><td>Entreprendre une tâche unique</td><td><div><p>Effectuer les actions simples, complexes ou coordonnées relatives aux composantes mentales et physiques qui concernent le fait de mener à bien une tâche unique, comme commencer une tâche, organiser le temps, l'espace et les matériels nécessaires, définir le rythme d'exécution de cette tâche, et réaliser, mener à son terme et persévérer dans la réalisation de la tâche.</p>\n</div></td><td>d210-d299</td><td>d210</td><td><code>http://id.who.int/icd/entity/925278278</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#925278278</code>, <code>https://icd.who.int/browse/2026-01/icf/en#925278278</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/925278278/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/925278278/postcoordinationScale/performance</code></td><td/><td/><td/><td>d210-d299</td><td>d2108, d2109, d2103, d2100, d2102, d2101</td><td>Undertaking a single task</td></tr><tr><td style=\"white-space:nowrap\">e1102<a name=\"terminologie-icf-e1102\"> </a></td><td>Eau potable</td><td><div><p>Eau adaptée à et sans danger pour une consommation personnelle.</p>\n</div></td><td>e110</td><td>e1102</td><td><code>http://id.who.int/icd/entity/517755262</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#517755262</code>, <code>https://icd.who.int/browse/2026-01/icf/en#517755262</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/517755262/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e110</td><td/><td>Drinking water</td></tr><tr><td style=\"white-space:nowrap\">d410-d499<a name=\"terminologie-icf-d410-d499\"> </a></td><td>Mobilité</td><td><div><p>Ce chapitre porte sur le mouvement en changeant de position du corps ou en allant d'un endroit à un autre, en portant, en transportant ou en manipulant des objets, en marchant, courant ou grimpant, et en utilisant divers moyens de transport.</p>\n</div></td><td>d110-d999</td><td/><td><code>http://id.who.int/icd/entity/2048203604</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2048203604</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2048203604</code></td><td/><td>BlockL2-d41</td><td>d410-d499</td><td/><td>d110-d999</td><td>d450-d469, d430-d449, d470-d489, d410-d429, d498, d499</td><td>Mobility</td></tr><tr><td style=\"white-space:nowrap\">s32001<a name=\"terminologie-icf-s32001\"> </a></td><td>Dents permanentes</td><td/><td>s3200</td><td>s32001</td><td><code>http://id.who.int/icd/entity/1509521993</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1509521993</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1509521993</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1509521993/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1509521993/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s3200</td><td/><td>Permanent dentition</td></tr><tr><td style=\"white-space:nowrap\">s4303<a name=\"terminologie-icf-s4303\"> </a></td><td>Muscles respiratoires</td><td/><td>s430</td><td>s4303</td><td><code>http://id.who.int/icd/entity/495844982</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#495844982</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#495844982</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/495844982/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/495844982/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s430</td><td>s43031, s43030, s43039, s43038</td><td>Muscles of respiration</td></tr><tr><td style=\"white-space:nowrap\">b899<a name=\"terminologie-icf-b899\"> </a></td><td>Fonctions non précisées relatives à la peau et aux structures associées</td><td/><td>b810-b899</td><td>b899</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#745358104/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#745358104/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/745358104/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b810-b899</td><td/><td>Functions of the skin and related structures, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s398<a name=\"terminologie-icf-s398\"> </a></td><td>Autres structures précisées liées à la voix et à la parole</td><td/><td>s310-s399</td><td>s398</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2060264919/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2060264919/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2060264919/other/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/2060264919/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s310-s399</td><td/><td>Other specified structures involved in voice and speech</td></tr><tr><td style=\"white-space:nowrap\">b5359<a name=\"terminologie-icf-b5359\"> </a></td><td>Sensations non précisées relatives au système digestif</td><td/><td>b535</td><td>b5359</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2028728035/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2028728035/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2028728035/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b535</td><td/><td>Sensations associated with the digestive system, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s75001<a name=\"terminologie-icf-s75001\"> </a></td><td>Articulation de la hanche</td><td/><td>s7500</td><td>s75001</td><td><code>http://id.who.int/icd/entity/1401748164</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1401748164</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1401748164</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1401748164/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1401748164/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s7500</td><td/><td>Hip joint</td></tr><tr><td style=\"white-space:nowrap\">d1200<a name=\"terminologie-icf-d1200\"> </a></td><td>Explorer avec la bouche</td><td><div><p>Explorer des objets en utilisant la bouche ou les lèvres.</p>\n</div></td><td>d120</td><td>d1200</td><td><code>http://id.who.int/icd/entity/21260786</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#21260786</code>, <code>https://icd.who.int/browse/2026-01/icf/en#21260786</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/21260786/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/21260786/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d120</td><td/><td>Mouthing</td></tr><tr><td style=\"white-space:nowrap\">e2201<a name=\"terminologie-icf-e2201\"> </a></td><td>Animaux</td><td><div><p>Organismes multicellulaires du règne animal se différenciant des plantes par plusieurs caractéristiques, comme la capacité de locomotion, un métabolisme sans photosynthèse, une réponse marquée aux stimulations, une croissance limitée, une structure organique fixe, comme des animaux sauvages ou domestiques, les reptiles, les oiseaux, les poissons et les mammifères.</p>\n</div></td><td>e220</td><td>e2201</td><td><code>http://id.who.int/icd/entity/684910879</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#684910879</code>, <code>https://icd.who.int/browse/2026-01/icf/en#684910879</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/684910879/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e220</td><td/><td>Animals</td></tr><tr><td style=\"white-space:nowrap\">d4155<a name=\"terminologie-icf-d4155\"> </a></td><td>Maintenir la position de la tête</td><td><div><p>Contrôler la position de la tête et soutenir son poids pendant une durée déterminée.</p>\n</div></td><td>d415</td><td>d4155</td><td><code>http://id.who.int/icd/entity/1474003417</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1474003417</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1474003417</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1474003417/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1474003417/postcoordinationScale/performance</code></td><td/><td/><td/><td>d415</td><td/><td>Maintaining head position</td></tr><tr><td style=\"white-space:nowrap\">d2402<a name=\"terminologie-icf-d2402\"> </a></td><td>Faire face à une crise</td><td><div><p>Effectuer les actions simples ou complexes et coordonnées qu'une personne doit accomplir pour réagir comme il le faut dans des situations décisives ou en présence d'un danger imminent ou de difficultés.</p>\n</div></td><td>d240</td><td>d2402</td><td><code>http://id.who.int/icd/entity/303332072</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#303332072</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#303332072</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/303332072/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/303332072/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d240</td><td/><td>Handling crisis</td></tr><tr><td style=\"white-space:nowrap\">d1329<a name=\"terminologie-icf-d1329\"> </a></td><td>Acquérir le langage, non précisés</td><td/><td>d132</td><td>d1329</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#840583219/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#840583219/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/840583219/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/840583219/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d132</td><td/><td>Acquiring language, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d650<a name=\"terminologie-icf-d650\"> </a></td><td>S'occuper des effets ménagers</td><td><div><p>Entretenir et réparer les objets du ménage et ses effets personnels, y compris le matériel de jeu, la maison et son contenu, les vêtements, les jeux et les articles de loisirs, les véhicules et les aides techniques, et prendre soin des plantes et des animaux, y compris notamment peindre et tapisser les pièces, réparer les meubles, réparer la plomberie, assurer l'entretien des véhicules, arroser les plantes, toiletter et nourrir les animaux de compagnie et domestiques, entretenir les entrées, les allées et les voies d'accès.</p>\n</div></td><td>d650-d669</td><td>d650</td><td><code>http://id.who.int/icd/entity/1957996741</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1957996741</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1957996741</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1957996741/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1957996741/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d650-d669</td><td>d6503, d6509, d6505, d6507, d6501, d6508, d6506, d6502, d6504, d6500</td><td>Caring for household objects</td></tr><tr><td style=\"white-space:nowrap\">d4709<a name=\"terminologie-icf-d4709\"> </a></td><td>Activités non précisées relatives à l'utilisation d'un moyen de transport</td><td/><td>d470</td><td>d4709</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#267105207/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#267105207/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/267105207/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/267105207/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d470</td><td/><td>Using transportation, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b460<a name=\"terminologie-icf-b460\"> </a></td><td>Sensations associées aux fonctions cardio-vasculaires et respiratoires</td><td><div><p>Sensations telles que sauter un battement du cœur, avoir des palpitations et avoir le souffle court.</p>\n</div></td><td>b450-b469</td><td>b460</td><td><code>http://id.who.int/icd/entity/1012679886</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1012679886</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1012679886</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1012679886/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b450-b469</td><td/><td>Sensations associated with cardiovascular and respiratory functions</td></tr><tr><td style=\"white-space:nowrap\">s599<a name=\"terminologie-icf-s599\"> </a></td><td>Structures non précisées liées aux systèmes digestif, métabolique et endocrinien</td><td/><td>s510-s599</td><td>s599</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#138182487/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#138182487/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/138182487/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/138182487/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s510-s599</td><td/><td>Structures related to the digestive, metabolic and endocrine systems, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s810-s899<a name=\"terminologie-icf-s810-s899\"> </a></td><td>Peau et structures annexes</td><td/><td>s110-s899</td><td/><td><code>http://id.who.int/icd/entity/84496745</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#84496745</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#84496745</code></td><td/><td>BlockL2-s81</td><td>s810-s899</td><td/><td>s110-s899</td><td>s810, s840, s830, s820, s898, s899</td><td>Skin and related structures</td></tr><tr><td style=\"white-space:nowrap\">b7202<a name=\"terminologie-icf-b7202\"> </a></td><td>Mobilité des os carpiens</td><td><div><p>Fonctions relatives à l'amplitude et à la facilité de mouvement des os du carpe.</p>\n</div></td><td>b720</td><td>b7202</td><td><code>http://id.who.int/icd/entity/1544887280</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1544887280</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1544887280</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1544887280/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b720</td><td/><td>Mobility of carpal bones</td></tr><tr><td style=\"white-space:nowrap\">b3109<a name=\"terminologie-icf-b3109\"> </a></td><td>Fonctions non précisées de la voix</td><td/><td>b310</td><td>b3109</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#712570723/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#712570723/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/712570723/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b310</td><td/><td>Voice functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">qp9<a name=\"terminologie-icf-qp9\"> </a></td><td>Difficulté en termes de performance, sans objet</td><td/><td>qp0-qp9</td><td>qp9</td><td><code>http://id.who.int/icd/entity/1405260925</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1405260925</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1405260925</code></td><td/><td/><td/><td/><td>qp0-qp9</td><td/><td>performance difficulty, not applicable</td></tr><tr><td style=\"white-space:nowrap\">b1721<a name=\"terminologie-icf-b1721\"> </a></td><td>Calcul complexe</td><td><div><p>Fonctions mentales permettant de traduire des problèmes sous forme d'énoncés en fonctions arithmétiques, de traduire des formules mathématiques en fonctions arithmétiques et autres manipulations complexes faisant appel aux nombres.</p>\n</div></td><td>b172</td><td>b1721</td><td><code>http://id.who.int/icd/entity/1952662712</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1952662712</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1952662712</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1952662712/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b172</td><td/><td>Complex calculation</td></tr><tr><td style=\"white-space:nowrap\">b435<a name=\"terminologie-icf-b435\"> </a></td><td>Fonctions du système immunitaire</td><td><div><p>Fonctions du corps liées à la protection contre des substances étrangères, y compris les infections causées par des réactions immunitaires spécifiques et non spécifiques.</p>\n</div></td><td>b430-b439</td><td>b435</td><td><code>http://id.who.int/icd/entity/1611249546</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1611249546</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1611249546</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1611249546/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b430-b439</td><td>b4358, b4350, b4359, b4352, b4353, b4351</td><td>Immunological system functions</td></tr><tr><td style=\"white-space:nowrap\">b310-b399<a name=\"terminologie-icf-b310-b399\"> </a></td><td>Fonctions de la voix et de la parole</td><td><div><p>Ce chapitre traite des fonctions de production des sons et de la parole.</p>\n</div></td><td>b110-b899</td><td/><td><code>http://id.who.int/icd/entity/388067588</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#388067588</code>, <code>https://icd.who.int/browse/2026-01/icf/en#388067588</code></td><td/><td>BlockL2-b31</td><td>b310-b399</td><td/><td>b110-b899</td><td>b310, b340, b320, b330, b398, b399</td><td>Voice and speech functions</td></tr><tr><td style=\"white-space:nowrap\">e5752<a name=\"terminologie-icf-e5752\"> </a></td><td>Politiques relatives aux services sociaux généraux</td><td><div><p>Textes de loi, réglementations et normes concernant les programmes et autres dispositifs d'aide aux personnes qui, en raison de leur âge, de leurs moyens financiers, du chômage, de leur état de santé ou d'une incapacité, ont besoin de cette aide, comme les textes de loi et autres réglementations régissant l'admission aux bénéfices de l'aide sociale.</p>\n</div></td><td>e575</td><td>e5752</td><td><code>http://id.who.int/icd/entity/805927997</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#805927997</code>, <code>https://icd.who.int/browse/2026-01/icf/en#805927997</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/805927997/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e575</td><td/><td>General social support policies</td></tr><tr><td style=\"white-space:nowrap\">d2401<a name=\"terminologie-icf-d2401\"> </a></td><td>Faire face au stress</td><td><div><p>Effectuer les actions simples ou complexes et coordonnées nécessaires pour répondre à la pression, à l'urgence et au stress associés à l'accomplissement d'une tâche, comme attendre que ce soit son tour, prendre une profonde respiration pour garder son calme, chercher de manière systématique les objets perdus ou surveiller l’heure.</p>\n</div></td><td>d240</td><td>d2401</td><td><code>http://id.who.int/icd/entity/728553384</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#728553384</code>, <code>https://icd.who.int/browse/2026-01/icf/en#728553384</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/728553384/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/728553384/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d240</td><td/><td>Handling stress</td></tr><tr><td style=\"white-space:nowrap\">s2205<a name=\"terminologie-icf-s2205\"> </a></td><td>Corps vitré</td><td/><td>s220</td><td>s2205</td><td><code>http://id.who.int/icd/entity/1914893267</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1914893267</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1914893267</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1914893267/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1914893267/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s220</td><td/><td>Vitreous body</td></tr><tr><td style=\"white-space:nowrap\">d2409<a name=\"terminologie-icf-d2409\"> </a></td><td>Activités non précisées pour faire face au stress et aux autres demandes psychologiques</td><td/><td>d240</td><td>d2409</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#639612322/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#639612322/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/639612322/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/639612322/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d240</td><td/><td>Handling stress and other psychological demands, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b7151<a name=\"terminologie-icf-b7151\"> </a></td><td>Stabilité de plusieurs articulations</td><td><div><p>Fonctions relatives au maintien de l'intégrité structurelle de plus d'une articulation.</p>\n</div></td><td>b715</td><td>b7151</td><td><code>http://id.who.int/icd/entity/2132385840</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2132385840</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2132385840</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2132385840/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b715</td><td/><td>Stability of several joints</td></tr><tr><td style=\"white-space:nowrap\">b545<a name=\"terminologie-icf-b545\"> </a></td><td>Fonctions d'équilibre hydrique, minéral et électrolytique</td><td><div><p>Fonctions de la régulation de l'eau, des minéraux et des électrolytes dans l'organisme.</p>\n</div></td><td>b540-b559</td><td>b545</td><td><code>http://id.who.int/icd/entity/1240717718</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1240717718</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1240717718</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1240717718/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b540-b559</td><td>b5450, b5452, b5458, b5451, b5459</td><td>Water, mineral and electrolyte balance functions</td></tr><tr><td style=\"white-space:nowrap\">b4353<a name=\"terminologie-icf-b4353\"> </a></td><td>Fonctions des ganglions lymphatiques</td><td><div><p>Fonctions liées aux nodules qui longent les vaisseaux lymphatiques.</p>\n</div></td><td>b435</td><td>b4353</td><td><code>http://id.who.int/icd/entity/1188898296</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1188898296</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1188898296</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1188898296/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b435</td><td/><td>Functions of lymph nodes</td></tr><tr><td style=\"white-space:nowrap\">d130-d159<a name=\"terminologie-icf-d130-d159\"> </a></td><td>Apprentissage élémentaire</td><td/><td>d110-d199</td><td/><td><code>http://id.who.int/icd/entity/1314143106</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1314143106</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1314143106</code></td><td/><td>BlockL3-d13</td><td>d130-d159</td><td/><td>d110-d199</td><td>d150, d155, d133, d145, d140, d132, d137, d131, d135, d130, d159, d138</td><td>Basic learning</td></tr><tr><td style=\"white-space:nowrap\">d4107<a name=\"terminologie-icf-d4107\"> </a></td><td>Se tourner en roulant</td><td><div><p>Changer le corps d'une position à une autre en étant allongé comme se tourner d'un côté à l'autre ou passer de la position ventrale à la position dorsale.</p>\n</div></td><td>d410</td><td>d4107</td><td><code>http://id.who.int/icd/entity/1851215071</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1851215071</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1851215071</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1851215071/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1851215071/postcoordinationScale/performance</code></td><td/><td/><td/><td>d410</td><td/><td>Rolling over</td></tr><tr><td style=\"white-space:nowrap\">b5106<a name=\"terminologie-icf-b5106\"> </a></td><td>Fonctions d'expulsion des contenus de l'estomac, de l'œsophage et du pharynx</td><td><div><p>Fonctions relatives au mouvement de substances telles que des aliments, des liquides, des médicaments, des objets avalés intentionnellement ou non, dans le sens inverse de l'ingestion, telles que dans la régurgitation et le vomissement.</p>\n</div></td><td>b510</td><td>b5106</td><td><code>http://id.who.int/icd/entity/242704590</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#242704590</code>, <code>https://icd.who.int/browse/2026-01/icf/en#242704590</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/242704590/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b510</td><td>b51061, b51060</td><td>Functions of expelling the contents of the stomach, oesophagus or pharynx</td></tr><tr><td style=\"white-space:nowrap\">e585<a name=\"terminologie-icf-e585\"> </a></td><td>Services, systèmes et politiques relatifs à l'éducation et à la formation</td><td><div><p>Services, systèmes et politiques relatifs à l'acquisition, l'entretien et l'amélioration des connaissances et du savoir, des compétences et des savoir-faire professionnels et artistiques. Voir la Classification Internationale Type de l'Éducation (CITE) de l'UNESCO.</p>\n</div></td><td>e510-e599</td><td>e585</td><td><code>http://id.who.int/icd/entity/151943128</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#151943128</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#151943128</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/151943128/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e510-e599</td><td>e5850, e5858, e5859, e5852, e5851</td><td>Education and training services, systems and policies</td></tr><tr><td style=\"white-space:nowrap\">s75011<a name=\"terminologie-icf-s75011\"> </a></td><td>Articulation du genou</td><td/><td>s7501</td><td>s75011</td><td><code>http://id.who.int/icd/entity/760635421</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#760635421</code>, <code>https://icd.who.int/browse/2026-01/icf/en#760635421</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/760635421/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/760635421/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s7501</td><td/><td>Knee joint</td></tr><tr><td style=\"white-space:nowrap\">d7204<a name=\"terminologie-icf-d7204\"> </a></td><td>Préserver l'espace social</td><td><div><p>Être conscient et préserver entre soi-même et les autres une distance qui soit adaptée aux circonstances, aux conventions sociales et aux convenances.</p>\n</div></td><td>d720</td><td>d7204</td><td><code>http://id.who.int/icd/entity/1482290368</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1482290368</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1482290368</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1482290368/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1482290368/postcoordinationScale/performance</code></td><td/><td/><td/><td>d720</td><td/><td>Maintaining social space</td></tr><tr><td style=\"white-space:nowrap\">e1250<a name=\"terminologie-icf-e1250\"> </a></td><td>Produits et systèmes techniques généraux pour la communication</td><td><div><p>Produits, équipements et systèmes techniques utilisés pour envoyer et recevoir des informations, comme des appareils optiques et acoustiques, des enregistreurs audio et des récepteurs, des appareils de télévision et de vidéo, des appareils de téléphone, des systèmes de transmission sonore et des appareils de communication face à face, et qui n'ont pas été adaptés ou spécialement conçus.</p>\n</div></td><td>e125</td><td>e1250</td><td><code>http://id.who.int/icd/entity/720932478</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#720932478</code>, <code>https://icd.who.int/browse/2026-01/icf/en#720932478</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/720932478/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e125</td><td/><td>General products and technology for communication</td></tr><tr><td style=\"white-space:nowrap\">d335<a name=\"terminologie-icf-d335\"> </a></td><td>Produire des messages non verbaux</td><td><div><p>Utiliser des gestes, des symboles et des dessins pour transmettre des messages, comme hocher la tête pour indiquer un désaccord ou dessiner un schéma pour expliquer un fait ou une idée complexe.</p>\n</div></td><td>d330-d349</td><td>d335</td><td><code>http://id.who.int/icd/entity/1116290334</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1116290334</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1116290334</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1116290334/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1116290334/postcoordinationScale/performance</code></td><td/><td/><td/><td>d330-d349</td><td>d3352, d3358, d3350, d3351, d3359</td><td>Producing nonverbal messages</td></tr><tr><td style=\"white-space:nowrap\">d640<a name=\"terminologie-icf-d640\"> </a></td><td>Faire le ménage</td><td><div><p>Gérer le ménage, en nettoyant la maison, en lavant les vêtements, en utilisant des appareils ménagers, en entreposant la nourriture, en éliminant les ordures, en balayant, en passant le torchon, en lavant les armoires, les murs et autres surfaces, en rassemblant et en éliminant les ordures ménagères ; en rangeant les pièces, les armoires et les tiroirs, en rassemblant, lavant, séchant, pliant et repassant le linge ; en frottant les chaussures ; en utilisant des balais, des brosses et des aspirateurs ; en utilisant des lave-linge, des sèche-linge et des fers à repasser.</p>\n</div></td><td>d630-d649</td><td>d640</td><td><code>http://id.who.int/icd/entity/1394299422</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1394299422</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1394299422</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1394299422/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1394299422/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d630-d649</td><td>d6402, d6400, d6405, d6403, d6408, d6409, d6404, d6401</td><td>Doing housework</td></tr><tr><td style=\"white-space:nowrap\">b28019<a name=\"terminologie-icf-b28019\"> </a></td><td>Douleur localisée non précisée</td><td/><td>b2801</td><td>b28019</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#577558794/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#577558794/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/577558794/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b2801</td><td/><td>Pain in body part, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s4209<a name=\"terminologie-icf-s4209\"> </a></td><td>Structure non précisée du système immunitaire</td><td/><td>s420</td><td>s4209</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1336997472/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1336997472/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1336997472/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1336997472/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s420</td><td/><td>Structure of immune system, unspecified</td></tr><tr><td style=\"white-space:nowrap\">e310<a name=\"terminologie-icf-e310\"> </a></td><td>Famille proche</td><td><div><p>Personnes liées par la naissance, par alliance ou par d'autres relations, culturellement reconnues comme constituant la famille proche comme les conjoints, partenaires, parents, frères et sœurs, enfants, parents adoptifs et grands-parents.</p>\n</div></td><td>e310-e399</td><td>e310</td><td><code>http://id.who.int/icd/entity/779158576</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#779158576</code>, <code>https://icd.who.int/browse/2026-01/icf/en#779158576</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/779158576/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e310-e399</td><td/><td>Immediate family</td></tr><tr><td style=\"white-space:nowrap\">d7608<a name=\"terminologie-icf-d7608\"> </a></td><td>Autres relations familiales précisées</td><td/><td>d760</td><td>d7608</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#877156484/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#877156484/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/877156484/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/877156484/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d760</td><td/><td>Other specified family relationships</td></tr><tr><td style=\"white-space:nowrap\">d460<a name=\"terminologie-icf-d460\"> </a></td><td>Se déplacer dans différents lieux</td><td><div><p>Marcher et se déplacer dans diférents lieux et dans diverses situations, comme aller d'une pièce à l'autre dans la maison, dans un immeuble, ou dans la rue.</p>\n</div></td><td>d450-d469</td><td>d460</td><td><code>http://id.who.int/icd/entity/971000452</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#971000452</code>, <code>https://icd.who.int/browse/2026-01/icf/en#971000452</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/971000452/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/971000452/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d450-d469</td><td>d4601, d4600, d4609, d4602, d4608</td><td>Moving around in different locations</td></tr><tr><td style=\"white-space:nowrap\">b7652<a name=\"terminologie-icf-b7652\"> </a></td><td>Tics et maniérismes</td><td><div><p>Fonctions relatives aux contractions répétitives, quasi-intentionnelles, involontaires d'un groupe de muscles.</p>\n</div></td><td>b765</td><td>b7652</td><td><code>http://id.who.int/icd/entity/1633520042</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1633520042</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1633520042</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1633520042/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b765</td><td/><td>Tics and mannerisms</td></tr><tr><td style=\"white-space:nowrap\">s7109<a name=\"terminologie-icf-s7109\"> </a></td><td>Structure non précisée de la région de la tête et du cou</td><td/><td>s710</td><td>s7109</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#436620656/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#436620656/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/436620656/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/436620656/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s710</td><td/><td>Structure of head and neck region, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b2150<a name=\"terminologie-icf-b2150\"> </a></td><td>Fonctions des muscles internes de l'œil</td><td><div><p>Fonctions des muscles à l'intérieur de l'œil, comme l'iris, qui ajustent la forme et la taille de la pupille et du cristallin.</p>\n</div></td><td>b215</td><td>b2150</td><td><code>http://id.who.int/icd/entity/1867763097</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1867763097</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1867763097</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1867763097/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b215</td><td/><td>Functions of internal muscles of the eye</td></tr><tr><td style=\"white-space:nowrap\">b130<a name=\"terminologie-icf-b130\"> </a></td><td>Fonctions de l'énergie et des pulsions</td><td><div><p>Fonctions mentales générales des mécanismes physiologiques et psychologiques qui poussent l'individu à aller de l'avant avec persistance pour répondre à des besoins spécifiques et atteindre des buts généraux.</p>\n</div></td><td>b110-b139</td><td>b130</td><td><code>http://id.who.int/icd/entity/723665457</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#723665457</code>, <code>https://icd.who.int/browse/2026-01/icf/en#723665457</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/723665457/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b110-b139</td><td>b1309, b1308, b1304, b1300, b1301, b1302, b1303</td><td>Energy and drive functions</td></tr><tr><td style=\"white-space:nowrap\">b7159<a name=\"terminologie-icf-b7159\"> </a></td><td>Fonctions non précisées relatives à la stabilité des articulations</td><td/><td>b715</td><td>b7159</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1264948861/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1264948861/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1264948861/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b715</td><td/><td>Stability of joint functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d3159<a name=\"terminologie-icf-d3159\"> </a></td><td>Communiquer - recevoir des messages non verbaux, formes non précisées</td><td/><td>d315</td><td>d3159</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1682771693/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1682771693/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1682771693/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1682771693/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d315</td><td/><td>Communicating with - receiving - nonverbal messages, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b11428<a name=\"terminologie-icf-b11428\"> </a></td><td>Autres orientations précisées par rapport à une personne</td><td/><td>b1142</td><td>b11428</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1023908327/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1023908327/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1023908327/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b1142</td><td/><td>Other specified orientation to person</td></tr><tr><td style=\"white-space:nowrap\">b7801<a name=\"terminologie-icf-b7801\"> </a></td><td>Sensation de spasme musculaire</td><td><div><p>Sensation de contraction involontaire d'un muscle ou d'un groupe de muscles.</p>\n</div></td><td>b780</td><td>b7801</td><td><code>http://id.who.int/icd/entity/621727843</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#621727843</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#621727843</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/621727843/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b780</td><td/><td>Sensation of muscle spasm</td></tr><tr><td style=\"white-space:nowrap\">b2802<a name=\"terminologie-icf-b2802\"> </a></td><td>Douleurs à localisations multiples</td><td><div><p>Sensation désagréable indiquant des dommages potentiels ou réels à une structure anatomique située dans plusieurs parties du corps.</p>\n</div></td><td>b280</td><td>b2802</td><td><code>http://id.who.int/icd/entity/454325322</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#454325322</code>, <code>https://icd.who.int/browse/2026-01/icf/en#454325322</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/454325322/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b280</td><td/><td>Pain in multiple body parts</td></tr><tr><td style=\"white-space:nowrap\">s2609<a name=\"terminologie-icf-s2609\"> </a></td><td>Structure non précisée de l'oreille interne</td><td/><td>s260</td><td>s2609</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#426292658/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#426292658/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/426292658/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/426292658/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s260</td><td/><td>Structure of inner ear, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s75021<a name=\"terminologie-icf-s75021\"> </a></td><td>Articulation de la cheville et articulations du pied et des orteils</td><td/><td>s7502</td><td>s75021</td><td><code>http://id.who.int/icd/entity/1967704373</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1967704373</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1967704373</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1967704373/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1967704373/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s7502</td><td/><td>Ankle joint and joints of foot and toes</td></tr><tr><td style=\"white-space:nowrap\">d4150<a name=\"terminologie-icf-d4150\"> </a></td><td>Rester couché</td><td><div><p>Rester allongé pendant un certain temps si nécessaire, comme rester couché sur le ventre dans le lit.</p>\n</div></td><td>d415</td><td>d4150</td><td><code>http://id.who.int/icd/entity/475166233</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#475166233</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#475166233</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/475166233/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/475166233/postcoordinationScale/performance</code></td><td/><td/><td/><td>d415</td><td/><td>Maintaining a lying position</td></tr><tr><td style=\"white-space:nowrap\">d1378<a name=\"terminologie-icf-d1378\"> </a></td><td>Acquérir des concepts, autres précisés</td><td/><td>d137</td><td>d1378</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2039726067/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2039726067/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2039726067/other/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/2039726067/other/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d137</td><td/><td>Other specified acquiring concepts</td></tr><tr><td style=\"white-space:nowrap\">e520<a name=\"terminologie-icf-e520\"> </a></td><td>Services, systèmes et politiques relatifs à la planification des zones de plein air</td><td><div><p>Services, systèmes et politiques destinés à la planification, la conception, le développement et l'entretien du domaine public (parcs, forêts, littoral, marais) et du domaine privé, dans le contexte rural, suburbain et urbain.</p>\n</div></td><td>e510-e599</td><td>e520</td><td><code>http://id.who.int/icd/entity/1236365481</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1236365481</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1236365481</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1236365481/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e510-e599</td><td>e5208, e5202, e5200, e5209, e5201</td><td>Open space planning services, systems and policies</td></tr><tr><td style=\"white-space:nowrap\">e1101<a name=\"terminologie-icf-e1101\"> </a></td><td>Médicaments</td><td><div><p>Objets ou substances naturels ou fabriqués par l'homme, qui sont ramassés, traités ou fabriqués à des fins médicinales pour l'homme, comme les médicaments allopathiques ou homéopathiques.</p>\n</div></td><td>e110</td><td>e1101</td><td><code>http://id.who.int/icd/entity/665123902</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#665123902</code>, <code>https://icd.who.int/browse/2026-01/icf/en#665123902</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/665123902/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e110</td><td/><td>Drugs</td></tr><tr><td style=\"white-space:nowrap\">d729<a name=\"terminologie-icf-d729\"> </a></td><td>Autres interactions générales avec autrui précisées et non précisées</td><td/><td>d710-d729</td><td>d729</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#573831863/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#573831863/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/573831863/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/573831863/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d710-d729</td><td/><td>General interpersonal interactions, other specified and unspecified</td></tr><tr><td style=\"white-space:nowrap\">b849<a name=\"terminologie-icf-b849\"> </a></td><td>Autres fonctions précisées et non précisées de la peau</td><td/><td>b810-b849</td><td>b849</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1382522180/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1382522180/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1382522180/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b810-b849</td><td/><td>Functions of the skin, other specified and unspecified</td></tr><tr><td style=\"white-space:nowrap\">s7200<a name=\"terminologie-icf-s7200\"> </a></td><td>Os de la région des épaules</td><td/><td>s720</td><td>s7200</td><td><code>http://id.who.int/icd/entity/1053363578</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1053363578</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1053363578</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1053363578/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1053363578/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s720</td><td/><td>Bones of shoulder region</td></tr><tr><td style=\"white-space:nowrap\">d730<a name=\"terminologie-icf-d730\"> </a></td><td>Relations avec des inconnus</td><td><div><p>Engager des contacts temporaires et avoir des liens avec des personnes que l'on ne connaît pas, dans un but bien précis, comme pour demander son chemin ou d'autres informations, ou acheter quelque chose.</p>\n</div></td><td>d730-d779</td><td>d730</td><td><code>http://id.who.int/icd/entity/327373045</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#327373045</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#327373045</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/327373045/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/327373045/postcoordinationScale/performance</code></td><td/><td/><td/><td>d730-d779</td><td/><td>Relating with strangers</td></tr><tr><td style=\"white-space:nowrap\">b16701<a name=\"terminologie-icf-b16701\"> </a></td><td>Réception du langage écrit</td><td><div><p>Fonctions mentales de décodage des messages écrits pour en dégager la signification.</p>\n</div></td><td>b1670</td><td>b16701</td><td><code>http://id.who.int/icd/entity/330258506</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#330258506</code>, <code>https://icd.who.int/browse/2026-01/icf/en#330258506</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/330258506/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b1670</td><td/><td>Reception of written language</td></tr><tr><td style=\"white-space:nowrap\">s75009<a name=\"terminologie-icf-s75009\"> </a></td><td>Structure non précisée de la cuisse</td><td/><td>s7500</td><td>s75009</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#435521956/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#435521956/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/435521956/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/435521956/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s7500</td><td/><td>Structure of thigh, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b4150<a name=\"terminologie-icf-b4150\"> </a></td><td>Fonctions des artères</td><td><div><p>Fonctions liées au flux sanguin dans les artères.</p>\n</div></td><td>b415</td><td>b4150</td><td><code>http://id.who.int/icd/entity/1794098135</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1794098135</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1794098135</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1794098135/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b415</td><td/><td>Functions of arteries</td></tr><tr><td style=\"white-space:nowrap\">d1500<a name=\"terminologie-icf-d1500\"> </a></td><td>Acquérir un savoir-faire de base en calcul</td><td><div><p>Apprendre les compétences élémentaires requises pour le calcul comme compter, ordonner et grouper.</p>\n</div></td><td>d150</td><td>d1500</td><td><code>http://id.who.int/icd/entity/645459240</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#645459240</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#645459240</code></td><td><code>http://id.who.int/icd/rel