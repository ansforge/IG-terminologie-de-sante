43/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1828012543/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1828012543/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1828012543/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d310-d399</td><td/><td>Communication, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b7351<a name=\"terminologie-icf-b7351\"> </a></td><td>Tonus des muscles d'un membre</td><td><div><p>Fonctions relatives à la tension présente dans les muscles et les groupes de muscles au repos d'un bras ou d'une jambe et à la résistance offerte lors de l'exécution de mouvements passifs.</p>\n</div></td><td>b735</td><td>b7351</td><td><code>http://id.who.int/icd/entity/1783884639</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1783884639</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1783884639</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1783884639/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b735</td><td/><td>Tone of muscles of one limb</td></tr><tr><td style=\"white-space:nowrap\">b298<a name=\"terminologie-icf-b298\"> </a></td><td>Autres fonctions sensorielles et douleur précisées</td><td/><td>b210-b299</td><td>b298</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1916167881/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1916167881/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1916167881/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b210-b299</td><td/><td>Other specified sensory functions and pain</td></tr><tr><td style=\"white-space:nowrap\">b2351<a name=\"terminologie-icf-b2351\"> </a></td><td>Fonction vestibulaire de l'équilibre</td><td><div><p>Fonctions sensorielles de l'oreille interne associées à la détermination de l'équilibre du corps.</p>\n</div></td><td>b235</td><td>b2351</td><td><code>http://id.who.int/icd/entity/1831985718</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1831985718</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1831985718</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1831985718/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b235</td><td/><td>Vestibular function of balance</td></tr><tr><td style=\"white-space:nowrap\">b7301<a name=\"terminologie-icf-b7301\"> </a></td><td>Puissance des muscles d'un membre</td><td><div><p>Fonctions relatives à la force générée par la contraction des muscles et des groupes de muscles d'un bras ou d'une jambe.</p>\n</div></td><td>b730</td><td>b7301</td><td><code>http://id.who.int/icd/entity/2106585049</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2106585049</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2106585049</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2106585049/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b730</td><td/><td>Power of muscles of one limb</td></tr><tr><td style=\"white-space:nowrap\">d132<a name=\"terminologie-icf-d132\"> </a></td><td>Acquérir le langage</td><td><div><p>Développer les compétences requises pour représenter des personnes, des objets, des événements, des sentiments par des mots, des symboles, des expressions et des phrases.</p>\n</div></td><td>d130-d159</td><td>d132</td><td><code>http://id.who.int/icd/entity/840583219</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#840583219</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#840583219</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/840583219/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/840583219/postcoordinationScale/performance</code></td><td/><td/><td/><td>d130-d159</td><td>d1328, d1322, d1321, d1329, d1320</td><td>Acquiring language</td></tr><tr><td style=\"white-space:nowrap\">b140<a name=\"terminologie-icf-b140\"> </a></td><td>Fonctions de l'attention</td><td><div><p>Fonctions mentales spécifiques de concentration sur un stimulus externe ou une expérience interne pour la période de temps requise.</p>\n</div></td><td>b140-b189</td><td>b140</td><td><code>http://id.who.int/icd/entity/1709276036</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1709276036</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1709276036</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1709276036/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b140-b189</td><td>b1408, b1409, b1403, b1402, b1400, b1401</td><td>Attention functions</td></tr><tr><td style=\"white-space:nowrap\">e575<a name=\"terminologie-icf-e575\"> </a></td><td>Services, systèmes et politiques relatifs aux services sociaux généraux</td><td><div><p>Services, systèmes et politiques visant à apporter l'aide requise aux personnes qui en ont besoin pour faire leurs courses, pour les travaux ménagers, les transports, les soins aux enfants, leur entretien personnel et l'entretien des autres, afin de leur permettre d'avoir une vie aussi normale que possible.</p>\n</div></td><td>e510-e599</td><td>e575</td><td><code>http://id.who.int/icd/entity/367297519</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#367297519</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#367297519</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/367297519/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e510-e599</td><td>e5758, e5750, e5759, e5751, e5752</td><td>General social support services, systems and policies</td></tr><tr><td style=\"white-space:nowrap\">e150<a name=\"terminologie-icf-e150\"> </a></td><td>Produits et systèmes techniques de l'architecture, de la construction et des aménagements des bâtiments d'utilité publique</td><td><div><p>Produits et systèmes techniques, y compris ceux qui sont adaptés ou spécialement conçus, constituant l'environnement d'une personne, à l'intérieur ou à l'extérieur, qui sont réalisés par l'homme et qui sont imaginés, conçus et construits pour l'usage public.</p>\n</div></td><td>e110-e199</td><td>e150</td><td><code>http://id.who.int/icd/entity/1379782912</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1379782912</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1379782912</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1379782912/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e110-e199</td><td>e1503, e1509, e1501, e1500, e1508, e1502</td><td>Design, construction and building products and technology of buildings for public use</td></tr><tr><td style=\"white-space:nowrap\">d1721<a name=\"terminologie-icf-d1721\"> </a></td><td>Utiliser les compétences et les stratégies nécessaires pour réaliser des opérations de calcul complexes</td><td><div><p>Appliquer des procédures mathématiques et des méthodes telles que l'algèbre, le calcul ou la géométrie pour résoudre des problèmes.</p>\n</div></td><td>d172</td><td>d1721</td><td><code>http://id.who.int/icd/entity/48165240</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#48165240</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#48165240</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/48165240/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/48165240/postcoordinationScale/performance</code></td><td/><td/><td/><td>d172</td><td/><td>Using skills and strategies to perform complex numeric operations and calculations</td></tr><tr><td style=\"white-space:nowrap\">d7401<a name=\"terminologie-icf-d7401\"> </a></td><td>Relations avec des subordonnés</td><td><div><p>Établir et entretenir des relations spécifiques avec des personnes occupant une position, ou jouissant d'un rang ou d'un prestige moindre par rapport à sa propre position sociale, comme un employé ou un domestique.</p>\n</div></td><td>d740</td><td>d7401</td><td><code>http://id.who.int/icd/entity/739172047</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#739172047</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#739172047</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/739172047/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/739172047/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d740</td><td/><td>Relating with subordinates</td></tr><tr><td style=\"white-space:nowrap\">b6501<a name=\"terminologie-icf-b6501\"> </a></td><td>Intervalle entre les menstruations</td><td><div><p>Fonctions régulant la durée entre deux cycles menstruels.</p>\n</div></td><td>b650</td><td>b6501</td><td><code>http://id.who.int/icd/entity/1139068789</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1139068789</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1139068789</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1139068789/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b650</td><td/><td>Interval between menstruation</td></tr><tr><td style=\"white-space:nowrap\">qf1<a name=\"terminologie-icf-qf1\"> </a></td><td>Facilitateur LÉGER (léger, faible, ...) 5-24%</td><td/><td>qb0-qf8</td><td>qf1</td><td><code>http://id.who.int/icd/entity/1040739675</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1040739675</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1040739675</code></td><td/><td/><td/><td/><td>qb0-qf8</td><td/><td>MILD facilitator (slight, low,...) 5-24%</td></tr><tr><td style=\"white-space:nowrap\">b110<a name=\"terminologie-icf-b110\"> </a></td><td>Fonctions de la conscience</td><td><div><p>Fonctions mentales générales de l'état de conscience de soi et de vigilance, y compris la clarté et la continuité de l'état de veille.</p>\n</div></td><td>b110-b139</td><td>b110</td><td><code>http://id.who.int/icd/entity/1060289548</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1060289548</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1060289548</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1060289548/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b110-b139</td><td>b1100, b1109, b1102, b1108, b1101</td><td>Consciousness functions</td></tr><tr><td style=\"white-space:nowrap\">s6302<a name=\"terminologie-icf-s6302\"> </a></td><td>Seins et mamelons</td><td/><td>s630</td><td>s6302</td><td><code>http://id.who.int/icd/entity/164520080</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#164520080</code>, <code>https://icd.who.int/browse/2026-01/icf/en#164520080</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/164520080/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/164520080/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s630</td><td/><td>Breast and nipple</td></tr><tr><td style=\"white-space:nowrap\">b110-b199<a name=\"terminologie-icf-b110-b199\"> </a></td><td>Fonctions mentales</td><td><div><p>Ce chapitre traite des fonctions du cerveau, à la fois des fonctions mentales globales, comme la conscience, l'énergie et les pulsions, et des fonctions mentales spécifiques, comme la mémoire, le langage et les fonctions de calcul mental.</p>\n</div></td><td>b110-b899</td><td/><td><code>http://id.who.int/icd/entity/1363559646</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1363559646</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1363559646</code></td><td/><td>BlockL2-b11</td><td>b110-b199</td><td/><td>b110-b899</td><td>b110-b139, b140-b189, b198, b199</td><td>Mental functions</td></tr><tr><td style=\"white-space:nowrap\">b510-b539<a name=\"terminologie-icf-b510-b539\"> </a></td><td>Fonctions relatives au système digestif</td><td/><td>b510-b599</td><td/><td><code>http://id.who.int/icd/entity/1976873960</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1976873960</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1976873960</code></td><td/><td>BlockL3-b51</td><td>b510-b539</td><td/><td>b510-b599</td><td>b520, b515, b535, b525, b530, b539, b510</td><td>Functions related to the digestive system</td></tr><tr><td style=\"white-space:nowrap\">b410-b499<a name=\"terminologie-icf-b410-b499\"> </a></td><td>Fonctions des systèmes cardiovasculaire, hématopoïétique, immunitaire et respiratoire</td><td><div><p>Ce chapitre traite des fonctions impliquées dans le système cardio-vasculaire (fonctions du cœur et des vaisseaux sanguins), les systèmes hématopoïétique et immunitaire (fonctions de production du sang et d'immunité) et le système respiratoire (fonctions de respiration et de tolérance à l'effort).</p>\n</div></td><td>b110-b899</td><td/><td><code>http://id.who.int/icd/entity/326705068</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#326705068</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#326705068</code></td><td/><td>BlockL2-b41</td><td>b410-b499</td><td/><td>b110-b899</td><td>b410-b429, b450-b469, b430-b439, b440-b449, b498, b499</td><td>Functions of the cardiovascular, haematological, immunological and respiratory systems</td></tr><tr><td style=\"white-space:nowrap\">d710-d729<a name=\"terminologie-icf-d710-d729\"> </a></td><td>Interactions générales avec autrui</td><td/><td>d710-d799</td><td/><td><code>http://id.who.int/icd/entity/573831863</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#573831863</code>, <code>https://icd.who.int/browse/2026-01/icf/en#573831863</code></td><td/><td>BlockL3-d71</td><td>d710-d729</td><td/><td>d710-d799</td><td>d710, d720, d729</td><td>General interpersonal interactions</td></tr><tr><td style=\"white-space:nowrap\">e2258<a name=\"terminologie-icf-e2258\"> </a></td><td>Autres éléments précisés du climat</td><td/><td>e225</td><td>e2258</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#621020081/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#621020081/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/621020081/other/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e225</td><td/><td>Other specified climate</td></tr><tr><td style=\"white-space:nowrap\">d5302<a name=\"terminologie-icf-d5302\"> </a></td><td>Apporter les soins au moment des menstruations</td><td><div><p>Coordonner, planifier et apporter les soins nécessaires au moment des menstruations, par ex. en prévoyant les menstruations et en utilisant des serviettes hygiéniques.</p>\n</div></td><td>d530</td><td>d5302</td><td><code>http://id.who.int/icd/entity/824249709</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#824249709</code>, <code>https://icd.who.int/browse/2026-01/icf/en#824249709</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/824249709/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/824249709/postcoordinationScale/performance</code></td><td/><td/><td/><td>d530</td><td/><td>Menstrual care</td></tr><tr><td style=\"white-space:nowrap\">b310<a name=\"terminologie-icf-b310\"> </a></td><td>Fonctions de la voix</td><td><div><p>Fonctions de production de divers sons par le passage de l’air dans le larynx.</p>\n</div></td><td>b310-b399</td><td>b310</td><td><code>http://id.who.int/icd/entity/712570723</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#712570723</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#712570723</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/712570723/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b310-b399</td><td>b3109, b3101, b3108, b3100</td><td>Voice functions</td></tr><tr><td style=\"white-space:nowrap\">b4159<a name=\"terminologie-icf-b4159\"> </a></td><td>Fonctions non précisées des vaisseaux sanguins</td><td/><td>b415</td><td>b4159</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1187873915/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1187873915/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1187873915/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b415</td><td/><td>Blood vessel functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s598<a name=\"terminologie-icf-s598\"> </a></td><td>Autres structures précisées liées aux systèmes digestif, métabolique et endocrinien</td><td/><td>s510-s599</td><td>s598</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#138182487/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#138182487/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/138182487/other/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/138182487/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s510-s599</td><td/><td>Other specified structures related to the digestive, metabolic and endocrine systems</td></tr><tr><td style=\"white-space:nowrap\">d9102<a name=\"terminologie-icf-d9102\"> </a></td><td>Cérémonies</td><td><div><p>S'investir dans des rites non religieux et des cérémonies ayant une signification sociale, comme les mariages, les funérailles ou des cérémonies d'initiation.</p>\n</div></td><td>d910</td><td>d9102</td><td><code>http://id.who.int/icd/entity/789797534</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#789797534</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#789797534</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/789797534/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/789797534/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d910</td><td/><td>Ceremonies</td></tr><tr><td style=\"white-space:nowrap\">d4554<a name=\"terminologie-icf-d4554\"> </a></td><td>Nager</td><td><div><p>Faire avancer le corps dans l'eau au moyen de mouvements des membres et du corps, sans prendre appui sur le sol.</p>\n</div></td><td>d455</td><td>d4554</td><td><code>http://id.who.int/icd/entity/1785164743</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1785164743</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1785164743</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1785164743/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1785164743/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d455</td><td/><td>Swimming</td></tr><tr><td style=\"white-space:nowrap\">e5401<a name=\"terminologie-icf-e5401\"> </a></td><td>Systèmes relatifs aux transports</td><td><div><p>Mécanismes de contrôle administratif et de surveillance régissant le déplacement des personnes ou des biens par la route ou autre voie terrestre, par chemin de fer, par air ou par mer, comme les dispositions accordant le droit d'exploiter les véhicules concernés, la mise en place et la surveillance de réglementations et de mesures de sécurité applicables aux différents moyens de transport.</p>\n</div></td><td>e540</td><td>e5401</td><td><code>http://id.who.int/icd/entity/319145981</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#319145981</code>, <code>https://icd.who.int/browse/2026-01/icf/en#319145981</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/319145981/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e540</td><td/><td>Transportation systems</td></tr><tr><td style=\"white-space:nowrap\">d825<a name=\"terminologie-icf-d825\"> </a></td><td>Formation professionnelle</td><td><div><p>Suivre les activités d'un programme de formation professionnelle et apprendre les cours qui préparent à un emploi dans le commerce, un métier ou une autre profession.</p>\n</div></td><td>d810-d839</td><td>d825</td><td><code>http://id.who.int/icd/entity/1691523199</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1691523199</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1691523199</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1691523199/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1691523199/postcoordinationScale/performance</code></td><td/><td/><td/><td>d810-d839</td><td/><td>Vocational training</td></tr><tr><td style=\"white-space:nowrap\">b4558<a name=\"terminologie-icf-b4558\"> </a></td><td>Autres fonctions précisées de tolérance à l'effort</td><td/><td>b455</td><td>b4558</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1409534054/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1409534054/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1409534054/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b455</td><td/><td>Other specified exercise tolerance functions</td></tr><tr><td style=\"white-space:nowrap\">b7109<a name=\"terminologie-icf-b7109\"> </a></td><td>Fonctions non précisées relatives à la mobilité des articulations</td><td/><td>b710</td><td>b7109</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#248265067/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#248265067/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/248265067/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b710</td><td/><td>Mobility of joint functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s4109<a name=\"terminologie-icf-s4109\"> </a></td><td>Structure non précisée du système cardio-vasculaire</td><td/><td>s410</td><td>s4109</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#397303672/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#397303672/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/397303672/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/397303672/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s410</td><td/><td>Structure of cardiovascular system, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d2303<a name=\"terminologie-icf-d2303\"> </a></td><td>Gérer son propre niveau d'activité</td><td><div><p>Effectuer les actions et adopter les comportements nécessaires pour gérer les exigences quotidiennes en énergie et en temps.</p>\n</div></td><td>d230</td><td>d2303</td><td><code>http://id.who.int/icd/entity/570465022</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#570465022</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#570465022</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/570465022/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/570465022/postcoordinationScale/performance</code></td><td/><td/><td/><td>d230</td><td/><td>Managing one's own activity level</td></tr><tr><td style=\"white-space:nowrap\">b1140<a name=\"terminologie-icf-b1140\"> </a></td><td>Orientation par rapport au temps</td><td><div><p>Fonctions mentales qui produisent la conscience de l'heure qu'il est, de quel jour de la semaine on est, de la date, du mois et de l'année.</p>\n</div></td><td>b114</td><td>b1140</td><td><code>http://id.who.int/icd/entity/324489319</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#324489319</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#324489319</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/324489319/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b114</td><td/><td>Orientation to time</td></tr><tr><td style=\"white-space:nowrap\">e1201<a name=\"terminologie-icf-e1201\"> </a></td><td>Aides techniques à la mobilité et le transport à l'intérieur et à l'extérieur des bâtiments</td><td><div><p>Produits, équipements et systèmes techniques, adaptés ou spécialement conçus, utilisés pour se déplacer à l'intérieur et à l'extérieur des bâtiments, comme les appareils d'aide à la marche, les voitures et fourgonnettes spéciales, les adaptations diverses aux véhicules, les fauteuils roulants, les motocyclettes, dispositifs de transfert.</p>\n</div></td><td>e120</td><td>e1201</td><td><code>http://id.who.int/icd/entity/705490490</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#705490490</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#705490490</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/705490490/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e120</td><td/><td>Assistive products and technology for personal indoor and outdoor mobility and transportation</td></tr><tr><td style=\"white-space:nowrap\">b749<a name=\"terminologie-icf-b749\"> </a></td><td>Autres fonctions musculaires précisées et non précisées</td><td/><td>b730-b749</td><td>b749</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1164313611/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1164313611/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1164313611/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b730-b749</td><td/><td>Muscle functions, other specified and unspecified</td></tr><tr><td style=\"white-space:nowrap\">b4409<a name=\"terminologie-icf-b4409\"> </a></td><td>Fonctions respiratoires non précisées</td><td/><td>b440</td><td>b4409</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#446199613/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#446199613/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/446199613/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b440</td><td/><td>Respiration functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d1750<a name=\"terminologie-icf-d1750\"> </a></td><td>Résoudre des problèmes simples</td><td><div><p>Trouver la réponse à une question simple ne comprenant qu'un seul élément en cernant et en analysant l'élément concerné, en mettant au point des solutions, en évaluant les effets potentiels des solutions et en mettant en œuvre la solution choisie.</p>\n</div></td><td>d175</td><td>d1750</td><td><code>http://id.who.int/icd/entity/619619009</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#619619009</code>, <code>https://icd.who.int/browse/2026-01/icf/en#619619009</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/619619009/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/619619009/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d175</td><td/><td>Solving simple problems</td></tr><tr><td style=\"white-space:nowrap\">e120<a name=\"terminologie-icf-e120\"> </a></td><td>Produits et systèmes techniques destinés à faciliter la mobilité et le transport à l'intérieur et à l'extérieur</td><td><div><p>Produits, équipements et systèmes techniques, y compris ceux qui sont adaptés ou spécialement conçus, utilisés pour se déplacer à l'intérieur et à l'extérieur des bâtiments, situés dans, sur ou près de la personne qui les utilise.</p>\n</div></td><td>e110-e199</td><td>e120</td><td><code>http://id.who.int/icd/entity/1663428215</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1663428215</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1663428215</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1663428215/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e110-e199</td><td>e1209, e1200, e1201, e1208</td><td>Products and technology for personal indoor and outdoor mobility and transportation</td></tr><tr><td style=\"white-space:nowrap\">d629<a name=\"terminologie-icf-d629\"> </a></td><td>Autres activités précisées et non précisées relatives à l'acquisition des produits d'usage courant</td><td/><td>d610-d629</td><td>d629</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1348372661/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1348372661/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1348372661/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1348372661/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d610-d629</td><td/><td>Acquisition of necessities, other specified and unspecified</td></tr><tr><td style=\"white-space:nowrap\">b6402<a name=\"terminologie-icf-b6402\"> </a></td><td>Fonctions de la phase orgasmique</td><td><div><p>Fonctions relatives à la réalisation de l'orgasme.</p>\n</div></td><td>b640</td><td>b6402</td><td><code>http://id.who.int/icd/entity/1652439900</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1652439900</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1652439900</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1652439900/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b640</td><td/><td>Functions of orgasmic phase</td></tr><tr><td style=\"white-space:nowrap\">e2100<a name=\"terminologie-icf-e2100\"> </a></td><td>Orographie</td><td><div><p>Caractéristiques des paysages terrestres, comme les montagnes, les collines, les vallées, les plaines, les plateaux et les déserts.</p>\n</div></td><td>e210</td><td>e2100</td><td><code>http://id.who.int/icd/entity/844275673</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#844275673</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#844275673</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/844275673/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e210</td><td/><td>Land forms</td></tr><tr><td style=\"white-space:nowrap\">e2600<a name=\"terminologie-icf-e2600\"> </a></td><td>Qualité de l'air à l'intérieur</td><td><div><p>Nature de l'air à l'intérieur des bâtiments ou dans les espaces clos, caractérisée par l'odeur, la présence de fumée, l'humidité, la climatisation (qualité de l'air contrôlée) ou absence de contrôle de la qualité de l'air, et susceptible de fournir des informations utiles sur le monde environnant (par ex. odeur de gaz) ou d'attirer l'attention (par ex. sensation enivrante d'un parfum).</p>\n</div></td><td>e260</td><td>e2600</td><td><code>http://id.who.int/icd/entity/359537409</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#359537409</code>, <code>https://icd.who.int/browse/2026-01/icf/en#359537409</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/359537409/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e260</td><td/><td>Indoor air quality</td></tr><tr><td style=\"white-space:nowrap\">b4551<a name=\"terminologie-icf-b4551\"> </a></td><td>Capacité aérobique</td><td><div><p>Fonctions liées à la capacité de faire de l'exercice sans s'essouffler.</p>\n</div></td><td>b455</td><td>b4551</td><td><code>http://id.who.int/icd/entity/1465070025</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1465070025</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1465070025</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1465070025/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b455</td><td/><td>Aerobic capacity</td></tr><tr><td style=\"white-space:nowrap\">e1309<a name=\"terminologie-icf-e1309\"> </a></td><td>Produits et systèmes techniques non précisés pour l'éducation</td><td/><td>e130</td><td>e1309</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#503282864/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#503282864/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/503282864/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e130</td><td/><td>Products and technology for education, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d7101<a name=\"terminologie-icf-d7101\"> </a></td><td>Gratitude</td><td><div><p>Faire preuve de, et réagir aux marques de, satisfaction et d'appréciation en fonction de diverses situations et dans le respect des convenances.</p>\n</div></td><td>d710</td><td>d7101</td><td><code>http://id.who.int/icd/entity/511185272</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#511185272</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#511185272</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/511185272/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/511185272/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d710</td><td/><td>Appreciation in relationships</td></tr><tr><td style=\"white-space:nowrap\">s3209<a name=\"terminologie-icf-s3209\"> </a></td><td>Structure non précisée de la bouche</td><td/><td>s320</td><td>s3209</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1754034822/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1754034822/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1754034822/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1754034822/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s320</td><td/><td>Structure of mouth, unspecified</td></tr><tr><td style=\"white-space:nowrap\">e5608<a name=\"terminologie-icf-e5608\"> </a></td><td>Autres services, systèmes et politiques précisés relatifs aux médias</td><td/><td>e560</td><td>e5608</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#548925174/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#548925174/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/548925174/other/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e560</td><td/><td>Other specified media services, systems and policies</td></tr><tr><td style=\"white-space:nowrap\">b7602<a name=\"terminologie-icf-b7602\"> </a></td><td>Coordination des mouvements volontaires</td><td><div><p>Fonctions relatives au contrôle et à la coordination de mouvements volontaires simples et complexes, les mouvements étant exécutés de façon ordonnée.</p>\n</div></td><td>b760</td><td>b7602</td><td><code>http://id.who.int/icd/entity/1988201774</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1988201774</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1988201774</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1988201774/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b760</td><td/><td>Coordination of voluntary movements</td></tr><tr><td style=\"white-space:nowrap\">e115<a name=\"terminologie-icf-e115\"> </a></td><td>Produits et systèmes techniques à usage personnel dans la vie quotidienne</td><td><div><p>Produits, équipements systèmes techniques utilisés par une personne dans sa vie quotidienne, qu'ils soient adaptés ou conçus spécialement, et situés dans, sur ou près de la personne qui les utilise.</p>\n</div></td><td>e110-e199</td><td>e115</td><td><code>http://id.who.int/icd/entity/1890760863</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1890760863</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1890760863</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1890760863/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e110-e199</td><td>e1150, e1158, e1151, e1159</td><td>Products and technology for personal use in daily living</td></tr><tr><td style=\"white-space:nowrap\">d4452<a name=\"terminologie-icf-d4452\"> </a></td><td>Chercher à prendre</td><td><div><p>Tendre les mains et les bras pour saisir quelque chose, comme pour étendre la main au-dessus d'une table pour prendre un livre.</p>\n</div></td><td>d445</td><td>d4452</td><td><code>http://id.who.int/icd/entity/7630894</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#7630894</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#7630894</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/7630894/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/7630894/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d445</td><td/><td>Reaching</td></tr><tr><td style=\"white-space:nowrap\">e5709<a name=\"terminologie-icf-e5709\"> </a></td><td>Services, systèmes et politiques non précisés relatifs à la sécurité sociale</td><td/><td>e570</td><td>e5709</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1584231471/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1584231471/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1584231471/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e570</td><td/><td>Social security services, systems and policies, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s4200<a name=\"terminologie-icf-s4200\"> </a></td><td>Vaisseaux lymphatiques</td><td/><td>s420</td><td>s4200</td><td><code>http://id.who.int/icd/entity/1008142941</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1008142941</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1008142941</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1008142941/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1008142941/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s420</td><td/><td>Lymphatic vessels</td></tr><tr><td style=\"white-space:nowrap\">d420<a name=\"terminologie-icf-d420\"> </a></td><td>Se transférer</td><td><div><p>Se transférer d'une surface à une autre, comme se glisser sur un banc ou passer du lit à une chaise sans changer de position.</p>\n</div></td><td>d410-d429</td><td>d420</td><td><code>http://id.who.int/icd/entity/1119392889</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1119392889</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1119392889</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1119392889/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1119392889/postcoordinationScale/performance</code></td><td/><td/><td/><td>d410-d429</td><td>d4201, d4200, d4208, d4209</td><td>Transferring oneself</td></tr><tr><td style=\"white-space:nowrap\">e1658<a name=\"terminologie-icf-e1658\"> </a></td><td>Autres produits précisés du patrimoine</td><td/><td>e165</td><td>e1658</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1101697000/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1101697000/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1101697000/other/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e165</td><td/><td>Other specified assets</td></tr><tr><td style=\"white-space:nowrap\">b1640<a name=\"terminologie-icf-b1640\"> </a></td><td>Abstraction</td><td><div><p>Fonctions mentales permettant d'inférer des idées générales, des qualités ou des caractéristiques à partir de réalités concrètes, d'objets précis ou des circonstances réelles mais distinctes d'elles.</p>\n</div></td><td>b164</td><td>b1640</td><td><code>http://id.who.int/icd/entity/879482047</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#879482047</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#879482047</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/879482047/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b164</td><td/><td>Abstraction</td></tr><tr><td style=\"white-space:nowrap\">d1452<a name=\"terminologie-icf-d1452\"> </a></td><td>Acquérir la compétence à écrire des mots et des phrases</td><td><div><p>Apprendre les actions de base requises pour transposer des mots ou des idées exprimés à l'oral en mots ou phrases écrits.</p>\n</div></td><td>d145</td><td>d1452</td><td><code>http://id.who.int/icd/entity/118913351</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#118913351</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#118913351</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/118913351/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/118913351/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d145</td><td/><td>Acquiring skills to write words and phrases</td></tr><tr><td style=\"white-space:nowrap\">s310-s399<a name=\"terminologie-icf-s310-s399\"> </a></td><td>Structures liées à la voix et à la parole</td><td/><td>s110-s899</td><td/><td><code>http://id.who.int/icd/entity/2060264919</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2060264919</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2060264919</code></td><td/><td>BlockL2-s31</td><td>s310-s399</td><td/><td>s110-s899</td><td>s330, s320, s310, s398, s340, s399</td><td>Structures involved in voice and speech</td></tr><tr><td style=\"white-space:nowrap\">b5253<a name=\"terminologie-icf-b5253\"> </a></td><td>Continence anale</td><td><div><p>Fonctions impliquées dans le contrôle volontaire de la fonction d'élimination.</p>\n</div></td><td>b525</td><td>b5253</td><td><code>http://id.who.int/icd/entity/1602912654</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1602912654</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1602912654</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1602912654/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b525</td><td/><td>Faecal continence</td></tr><tr><td style=\"white-space:nowrap\">b1143<a name=\"terminologie-icf-b1143\"> </a></td><td>Orientation par rapport aux objets</td><td><div><p>Fonctions mentales qui produisent la conscience des objets ou des caractéristiques des objets.</p>\n</div></td><td>b114</td><td>b1143</td><td><code>http://id.who.int/icd/entity/707788071</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#707788071</code>, <code>https://icd.who.int/browse/2026-01/icf/en#707788071</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/707788071/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b114</td><td/><td>Orientation to objects</td></tr><tr><td style=\"white-space:nowrap\">b6601<a name=\"terminologie-icf-b6601\"> </a></td><td>Fonctions relatives à la grossesse</td><td><div><p>Fonctions impliquées dans le fait de tomber enceinte et d'être enceinte.</p>\n</div></td><td>b660</td><td>b6601</td><td><code>http://id.who.int/icd/entity/1313660275</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1313660275</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1313660275</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1313660275/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b660</td><td/><td>Functions related to pregnancy</td></tr><tr><td style=\"white-space:nowrap\">b1301<a name=\"terminologie-icf-b1301\"> </a></td><td>Motivation</td><td><div><p>Fonctions mentales qui produisent la motivation d'agir, l'élément moteur conscient ou inconscient de l'action.</p>\n</div></td><td>b130</td><td>b1301</td><td><code>http://id.who.int/icd/entity/2016666007</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2016666007</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2016666007</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2016666007/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b130</td><td/><td>Motivation</td></tr><tr><td style=\"white-space:nowrap\">b45048<a name=\"terminologie-icf-b45048\"> </a></td><td>Autres fonctions précisées liées au mucus</td><td/><td>b4504</td><td>b45048</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#184992399/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#184992399/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/184992399/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b4504</td><td/><td>Other specified functions related to mucus</td></tr><tr><td style=\"white-space:nowrap\">s1101<a name=\"terminologie-icf-s1101\"> </a></td><td>Structure du mésencéphale</td><td/><td>s110</td><td>s1101</td><td><code>http://id.who.int/icd/entity/569734644</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#569734644</code>, <code>https://icd.who.int/browse/2026-01/icf/en#569734644</code