01/icf/13643816/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e245</td><td/><td>Lunar cycles</td></tr><tr><td style=\"white-space:nowrap\">b6609<a name=\"terminologie-icf-b6609\"> </a></td><td>Fonctions non précisées de procréation</td><td/><td>b660</td><td>b6609</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#689311651/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#689311651/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/689311651/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b660</td><td/><td>Procreation functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b6500<a name=\"terminologie-icf-b6500\"> </a></td><td>Régularité du cycle menstruel</td><td><div><p>Fonctions impliquées dans la régularité du cycle menstruel.</p>\n</div></td><td>b650</td><td>b6500</td><td><code>http://id.who.int/icd/entity/1422699445</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1422699445</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1422699445</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1422699445/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b650</td><td/><td>Regularity of menstrual cycle</td></tr><tr><td style=\"white-space:nowrap\">d8701<a name=\"terminologie-icf-d8701\"> </a></td><td>Indemnités et allocations publiques</td><td><div><p>Avoir la maîtrise de ses ressources économiques d'origine publique, afin d'assurer sa sécurité économique pour ses besoins présents et futurs.</p>\n</div></td><td>d870</td><td>d8701</td><td><code>http://id.who.int/icd/entity/671143794</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#671143794</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#671143794</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/671143794/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/671143794/postcoordinationScale/performance</code></td><td/><td/><td/><td>d870</td><td/><td>Public economic entitlements</td></tr><tr><td style=\"white-space:nowrap\">b640-b679<a name=\"terminologie-icf-b640-b679\"> </a></td><td>Fonctions génitales et reproductives</td><td/><td>b610-b699</td><td/><td><code>http://id.who.int/icd/entity/1868928861</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1868928861</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1868928861</code></td><td/><td>BlockL3-b64</td><td>b640-b679</td><td/><td>b610-b699</td><td>b640, b660, b650, b679, b670</td><td>Genital and reproductive functions</td></tr><tr><td style=\"white-space:nowrap\">e2108<a name=\"terminologie-icf-e2108\"> </a></td><td>Autres éléments précisés liés aux caractéristiques physiques de la terre</td><td/><td>e210</td><td>e2108</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#915627353/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#915627353/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/915627353/other/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e210</td><td/><td>Other specified physical features of the earth</td></tr><tr><td style=\"white-space:nowrap\">e5359<a name=\"terminologie-icf-e5359\"> </a></td><td>Services, systèmes et politiques non précisés relatifs à la communication</td><td/><td>e535</td><td>e5359</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2095193522/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2095193522/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2095193522/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e535</td><td/><td>Communication services, systems and policies, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d3350<a name=\"terminologie-icf-d3350\"> </a></td><td>Produire des messages gestuels</td><td><div><p>Transmettre des messages par des mouvements intentionnels du corps tels que les mimiques (par exemple sourire, froncer les sourcils, grimacer), par des mouvements des bras et des mains, par des attitudes comme prendre dans ses bras pour indiquer l'affection ou pointer du doigt pour attirer l'attention ou obtenir un objet.</p>\n</div></td><td>d335</td><td>d3350</td><td><code>http://id.who.int/icd/entity/219270693</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#219270693</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#219270693</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/219270693/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/219270693/postcoordinationScale/performance</code></td><td/><td/><td/><td>d335</td><td/><td>Producing body language</td></tr><tr><td style=\"white-space:nowrap\">d1550<a name=\"terminologie-icf-d1550\"> </a></td><td>Acquérir un savoir-faire de base</td><td><div><p>Apprendre des gestes élémentaires, effectués dans un but déterminé, comme utiliser des outils simples tels que des crayons ou des couverts.</p>\n</div></td><td>d155</td><td>d1550</td><td><code>http://id.who.int/icd/entity/832891312</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#832891312</code>, <code>https://icd.who.int/browse/2026-01/icf/en#832891312</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/832891312/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/832891312/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d155</td><td/><td>Acquiring basic skills</td></tr><tr><td style=\"white-space:nowrap\">e5201<a name=\"terminologie-icf-e5201\"> </a></td><td>Systèmes relatifs à la planification des zones de plein air</td><td><div><p>Mécanismes de contrôle administratif et de surveillance comme la mise en place et la surveillance de décisions locales, régionales ou nationales portant sur la planification, la conception, le développement et l'entretien des zones de plein air, qu'ils portent sur les domaines situés en zone rurale, suburbaine ou urbaine ou portent sur la protection des parcs et des réserves naturelles.</p>\n</div></td><td>e520</td><td>e5201</td><td><code>http://id.who.int/icd/entity/752556622</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#752556622</code>, <code>https://icd.who.int/browse/2026-01/icf/en#752556622</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/752556622/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e520</td><td/><td>Open space planning systems</td></tr><tr><td style=\"white-space:nowrap\">s2501<a name=\"terminologie-icf-s2501\"> </a></td><td>Trompe d'Eustache</td><td/><td>s250</td><td>s2501</td><td><code>http://id.who.int/icd/entity/163570699</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#163570699</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#163570699</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/163570699/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/163570699/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s250</td><td/><td>Eustachian canal</td></tr><tr><td style=\"white-space:nowrap\">qs3<a name=\"terminologie-icf-qs3\"> </a></td><td>partie additionnelle</td><td/><td>qs0-qs9</td><td>qs3</td><td><code>http://id.who.int/icd/entity/1581927533</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1581927533</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1581927533</code></td><td/><td/><td/><td/><td>qs0-qs9</td><td/><td>additional part</td></tr><tr><td style=\"white-space:nowrap\">b1148<a name=\"terminologie-icf-b1148\"> </a></td><td>Autres fonctions précisées d'orientation</td><td/><td>b114</td><td>b1148</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1670590220/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1670590220/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1670590220/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b114</td><td/><td>Other specified orientation functions</td></tr><tr><td style=\"white-space:nowrap\">b1341<a name=\"terminologie-icf-b1341\"> </a></td><td>Début du sommeil</td><td><div><p>Fonctions mentales qui produisent la transition entre l'état de veille et le sommeil.</p>\n</div></td><td>b134</td><td>b1341</td><td><code>http://id.who.int/icd/entity/288718794</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#288718794</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#288718794</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/288718794/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b134</td><td/><td>Onset of sleep</td></tr><tr><td style=\"white-space:nowrap\">b5459<a name=\"terminologie-icf-b5459\"> </a></td><td>Fonctions non précisées de maintien de l'équilibre hydrique, minéral et électrolytique</td><td/><td>b545</td><td>b5459</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1240717718/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1240717718/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1240717718/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b545</td><td/><td>Water, mineral and electrolyte balance functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">s1208<a name=\"terminologie-icf-s1208\"> </a></td><td>Autres structures précisées de la moelle épinière et des structures connexes</td><td/><td>s120</td><td>s1208</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2110142953/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2110142953/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2110142953/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/2110142953/other/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s120</td><td/><td>Other specified spinal cord and related structures</td></tr><tr><td style=\"white-space:nowrap\">b1304<a name=\"terminologie-icf-b1304\"> </a></td><td>Contrôle des pulsions</td><td><div><p>Fonctions mentales qui régulent et permettent de résister aux envies soudaines de faire quelque chose.</p>\n</div></td><td>b130</td><td>b1304</td><td><code>http://id.who.int/icd/entity/867833431</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#867833431</code>, <code>https://icd.who.int/browse/2026-01/icf/en#867833431</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/867833431/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b130</td><td/><td>Impulse control</td></tr><tr><td style=\"white-space:nowrap\">d1559<a name=\"terminologie-icf-d1559\"> </a></td><td>Acquérir des savoir-faire non précisés</td><td/><td>d155</td><td>d1559</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#402775005/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#402775005/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/402775005/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/402775005/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d155</td><td/><td>Acquiring skills, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d465<a name=\"terminologie-icf-d465\"> </a></td><td>Se déplacer en utilisant des équipements spéciaux</td><td><div><p>Déplacer le corps d'un endroit à l'autre, sur toute surface et dans toutes sortes d'espaces, en utilisant des appareils particuliers conçus pour faciliter le déplacement ou pour donner des moyens de déplacement nouveaux, comme les planches à roulettes, les skis, un équipement de plongée, les palmes ou descendre la rue en fauteuil roulant autonome ou avec un déambulateur.</p>\n</div></td><td>d450-d469</td><td>d465</td><td><code>http://id.who.int/icd/entity/40033904</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#40033904</code>, <code>https://icd.who.int/browse/2026-01/icf/en#40033904</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/40033904/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/40033904/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d450-d469</td><td/><td>Moving around using equipment</td></tr><tr><td style=\"white-space:nowrap\">d820<a name=\"terminologie-icf-d820\"> </a></td><td>Éducation scolaire</td><td><div><p>Accéder à l'école, à l’éducation, participer à toutes les activités scolaires, avec leurs responsabilités et leurs privilèges, apprendre les leçons, les matières et satisfaire aux exigences du programme dans un programme d'éducation primaire ou secondaire, y compris fréquenter l'école régulièrement, travailler en coopération avec d'autres élèves, suivre les instructions des enseignants, l'organisation, l'étude et l'achèvement des tâches et des projets à réaliser, et progresser vers d'autres niveaux d'éducation.</p>\n</div></td><td>d810-d839</td><td>d820</td><td><code>http://id.who.int/icd/entity/794521535</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#794521535</code>, <code>https://icd.who.int/browse/2026-01/icf/en#794521535</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/794521535/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/794521535/postcoordinationScale/performance</code></td><td/><td/><td/><td>d810-d839</td><td/><td>School education</td></tr><tr><td style=\"white-space:nowrap\">e350<a name=\"terminologie-icf-e350\"> </a></td><td>Animaux domestiques</td><td><div><p>Animaux qui apportent un soutien physique, affectif ou psychologique, comme les animaux de compagnie (chiens, chats, oiseaux, poissons, etc.) ; animaux qui aident à la mobilité personnelle et au transport.</p>\n</div></td><td>e310-e399</td><td>e350</td><td><code>http://id.who.int/icd/entity/1199020655</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1199020655</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1199020655</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1199020655/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e310-e399</td><td/><td>Domesticated animals</td></tr><tr><td style=\"white-space:nowrap\">d9100<a name=\"terminologie-icf-d9100\"> </a></td><td>Associations informelles</td><td><div><p>S'investir dans des associations à caractère social ou communautaire organisées par des personnes ayant des intérêts communs, comme des clubs locaux d'action sociale ou des groupes d'éthique.</p>\n</div></td><td>d910</td><td>d9100</td><td><code>http://id.who.int/icd/entity/21205790</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#21205790</code>, <code>https://icd.who.int/browse/2026-01/icf/en#21205790</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/21205790/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/21205790/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d910</td><td/><td>Informal associations</td></tr><tr><td style=\"white-space:nowrap\">b3401<a name=\"terminologie-icf-b3401\"> </a></td><td>Production d'une gamme de sons</td><td><div><p>Fonctions relatives à la production de vocalisations diverses.</p>\n</div></td><td>b340</td><td>b3401</td><td><code>http://id.who.int/icd/entity/1550098293</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1550098293</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1550098293</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1550098293/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b340</td><td/><td>Making a range of sounds</td></tr><tr><td style=\"white-space:nowrap\">d480<a name=\"terminologie-icf-d480\"> </a></td><td>Monter un animal comme moyen de transport</td><td><div><p>Voyager sur le dos d'un animal, comme un cheval, un bœuf, un chameau ou un éléphant.</p>\n</div></td><td>d470-d489</td><td>d480</td><td><code>http://id.who.int/icd/entity/1540367470</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1540367470</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1540367470</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1540367470/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1540367470/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d470-d489</td><td/><td>Riding animals for transportation</td></tr><tr><td style=\"white-space:nowrap\">d6101<a name=\"terminologie-icf-d6101\"> </a></td><td>Louer un logement</td><td><div><p>Entreprendre les activités nécessaires pour utiliser une maison, un appartement ou tout lieu d'habitation appartenant à autrui en échange d'une contribution financière.</p>\n</div></td><td>d610</td><td>d6101</td><td><code>http://id.who.int/icd/entity/533589093</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#533589093</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#533589093</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/533589093/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/533589093/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d610</td><td/><td>Renting a place to live</td></tr><tr><td style=\"white-space:nowrap\">d760<a name=\"terminologie-icf-d760\"> </a></td><td>Relations familiales</td><td><div><p>Établir et entretenir des relations familiales, comme avec les membres de la famille nucléaire, de la famille élargie, de la famille d'accueil ou d'adoption et la belle-famille, des relations plus distantes avec les cousins ou les tuteurs.</p>\n</div></td><td>d730-d779</td><td>d760</td><td><code>http://id.who.int/icd/entity/877156484</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#877156484</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#877156484</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/877156484/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/877156484/postcoordinationScale/performance</code></td><td/><td/><td/><td>d730-d779</td><td>d7601, d7608, d7603, d7600, d7602, d7609</td><td>Family relationships</td></tr><tr><td style=\"white-space:nowrap\">e5800<a name=\"terminologie-icf-e5800\"> </a></td><td>Services relatifs à la santé</td><td><div><p>Services et programmes, y compris les personnes qui s'en occupent aux niveaux local, communautaire, régional, de l'état ou national, visant à fournir des interventions aux individus concernant leur bien-être physique, psychologique et social, comme des services de promotion de la santé et de prévention de la maladie, des services de soins de santé primaire, des services de soins intensifs, des services de réadaptation et de soins à long terme, que ces services soient financés par des fonds publics ou privés, qu'ils soient assurés à court terme, à long terme, de manière périodique ou occasionnelle, dans toute une gamme d'environnements tels que la communauté, le domicile, l'école et le lieu de travail, les hôpitaux généraux, les hôpitaux spécialisés, les cliniques et les établissements de soins résidentiels et non résidentiels.</p>\n</div></td><td>e580</td><td>e5800</td><td><code>http://id.who.int/icd/entity/2073040991</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2073040991</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2073040991</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2073040991/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e580</td><td/><td>Health services</td></tr><tr><td style=\"white-space:nowrap\">b535<a name=\"terminologie-icf-b535\"> </a></td><td>Sensations associées au système digestif</td><td><div><p>Sensations provenant de l'alimentation, de la boisson et fonctions digestives associées.</p>\n</div></td><td>b510-b539</td><td>b535</td><td><code>http://id.who.int/icd/entity/2028728035</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2028728035</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2028728035</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2028728035/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b510-b539</td><td>b5351, b5358, b5352, b5359, b5350</td><td>Sensations associated with the digestive system</td></tr><tr><td style=\"white-space:nowrap\">s2202<a name=\"terminologie-icf-s2202\"> </a></td><td>Iris</td><td/><td>s220</td><td>s2202</td><td><code>http://id.who.int/icd/entity/402378131</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#402378131</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#402378131</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/402378131/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/402378131/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s220</td><td/><td>Iris</td></tr><tr><td style=\"white-space:nowrap\">s550<a name=\"terminologie-icf-s550\"> </a></td><td>Structure du pancréas</td><td/><td>s510-s599</td><td>s550</td><td><code>http://id.who.int/icd/entity/1716164672</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1716164672</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1716164672</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1716164672/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1716164672/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s510-s599</td><td/><td>Structure of pancreas</td></tr><tr><td style=\"white-space:nowrap\">b1642<a name=\"terminologie-icf-b1642\"> </a></td><td>Gestion du temps</td><td><div><p>Fonctions mentales d'ordonnancement des événements en séquence chronologique, allouant le temps aux événements et aux activités.</p>\n</div></td><td>b164</td><td>b1642</td><td><code>http://id.who.int/icd/entity/440081727</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#440081727</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#440081727</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/440081727/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b164</td><td/><td>Time management</td></tr><tr><td style=\"white-space:nowrap\">b1340<a name=\"terminologie-icf-b1340\"> </a></td><td>Quantité de sommeil</td><td><div><p>Fonctions mentales déterminant le temps passé en état de sommeil pendant le cycle diurne ou le rythme circadien.</p>\n</div></td><td>b134</td><td>b1340</td><td><code>http://id.who.int/icd/entity/102570762</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#102570762</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#102570762</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/102570762/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b134</td><td/><td>Amount of sleep</td></tr><tr><td style=\"white-space:nowrap\">s3204<a name=\"terminologie-icf-s3204\"> </a></td><td>Structure des lèvres</td><td/><td>s320</td><td>s3204</td><td><code>http://id.who.int/icd/entity/1690266126</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1690266126</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1690266126</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1690266126/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1690266126/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s320</td><td>s32041, s32040</td><td>Structure of lips</td></tr><tr><td style=\"white-space:nowrap\">d310<a name=\"terminologie-icf-d310\"> </a></td><td>Communiquer - recevoir des messages parlés</td><td><div><p>Comprendre la signification littérale et figurée de messages en langage parlé, comme comprendre qu'une phrase énonce un fait ou est une expression idiomatique.</p>\n</div></td><td>d310-d329</td><td>d310</td><td><code>http://id.who.int/icd/entity/1192395813</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1192395813</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1192395813</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1192395813/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1192395813/postcoordinationScale/performance</code></td><td/><td/><td/><td>d310-d329</td><td>d3103, d3102, d3109, d3101, d3108</td><td>Communicating with - receiving - spoken messages</td></tr><tr><td style=\"white-space:nowrap\">s7600<a name=\"terminologie-icf-s7600\"> </a></td><td>Structure de la colonne vertébrale</td><td/><td>s760</td><td>s7600</td><td><code>http://id.who.int/icd/entity/341679012</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#341679012</code>, <code>https://icd.who.int/browse/2026-01/icf/en#341679012</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/341679012/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/341679012/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s760</td><td>s76004, s76008, s76001, s76000, s76002, s76003</td><td>Structure of vertebral column</td></tr><tr><td style=\"white-space:nowrap\">qp3<a name=\"terminologie-icf-qp3\"> </a></td><td>Difficulté GRAVE en termes de performance (élevée, extrême, ...) 50-95%</td><td/><td>qp0-qp9</td><td>qp3</td><td><code>http://id.who.int/icd/entity/992904195</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#992904195</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#992904195</code></td><td/><td/><td/><td/><td>qp0-qp9</td><td/><td>SEVERE performance difficulty (high, extreme,...) 50-95 %</td></tr><tr><td style=\"white-space:nowrap\">b1265<a name=\"terminologie-icf-b1265\"> </a></td><td>Optimisme</td><td><div><p>Fonctions mentales qui produisent un tempérament enjoué, dynamique et plein d'espoirs, par opposition à triste, sombre et sans espoir.</p>\n</div></td><td>b126</td><td>b1265</td><td><code>http://id.who.int/icd/entity/1941079634</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1941079634</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1941079634</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1941079634/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b126</td><td/><td>Optimism</td></tr><tr><td style=\"white-space:nowrap\">b810-b899<a name=\"terminologie-icf-b810-b899\"> </a></td><td>Fonctions de la peau et des structures associées</td><td><div><p>Ce chapitre traite des fonctions de la peau, des ongles, des cheveux et des poils.</p>\n</div></td><td>b110-b899</td><td/><td><code>http://id.who.int/icd/entity/745358104</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/en#745358104</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#745358104</code></td><td/><td>BlockL2-b81</td><td>b810-b899</td><td/><td>b110-b899</td><td>b810-b849, b898, b850-b869, b899</td><td>Functions of the skin and related structures</td></tr><tr><td style=\"white-space:nowrap\">d1321<a name=\"terminologie-icf-d1321\"> </a></td><td>Combiner des mots pour construire des phrases</td><td><div><p>Apprendre à combiner des mots pour construire des phrases.</p>\n</div></td><td>d132</td><td>d1321</td><td><code>http://id.who.int/icd/entity/675964842</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#675964842</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#675964842</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/675964842/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/675964842/postcoordinationScale/performance</code></td><td/><td/><td/><td>d132</td><td/><td>Combining words into phrases</td></tr><tr><td style=\"white-space:nowrap\">s76008<a name=\"terminologie-icf-s76008\"> </a></td><td>Autre structure précisée de la colonne vertébrale</td><td/><td>s7600</td><td>s76008</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#341679012/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#341679012/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/341679012/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/341679012/other/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s7600</td><td/><td>Other specified structure of vertebral column</td></tr><tr><td style=\"white-space:nowrap\">e5708<a name=\"terminologie-icf-e5708\"> </a></td><td>Autres services, systèmes et politiques précisés relatifs à la sécurité sociale</td><td/><td>e570</td><td>e5708</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1584231471/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1584231471/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1584231471/other/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e570</td><td/><td>Other specified social security services, systems and policies</td></tr><tr><td style=\"white-space:nowrap\">b28014<a name=\"terminologie-icf-b28014\"> </a></td><td>Douleur au membre supérieur</td><td><div><p>Sensation désagréable indiquant des dommages potentiels ou réels à une structure anatomique située dans un ou les deux membres supérieurs, y compris les mains.</p>\n</div></td><td>b2801</td><td>b28014</td><td><code>http://id.who.int/icd/entity/1299345975</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1299345975</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1299345975</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1299345975/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b2801</td><td/><td>Pain in upper limb</td></tr><tr><td style=\"white-space:nowrap\">s32041<a name=\"terminologie-icf-s32041\"> </a></td><td>Lèvre inférieure</td><td/><td>s3204</td><td>s32041</td><td><code>http://id.who.int/icd/entity/822076440</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#822076440</code>, <code>https://icd.who.int/browse/2026-01/icf/en#822076440</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/822076440/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/822076440/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s3204</td><td/><td>Lower lip</td></tr><tr><td style=\"white-space:nowrap\">e2159<a name=\"terminologie-icf-e2159\"> </a></td><td>Éléments non précisés relatifs à la population</td><td/><td>e215</td><td>e2159</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2098899609/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2098899609/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2098899609/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e215</td><td/><td>Population, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b5401<a name=\"terminologie-icf-b5401\"> </a></td><td>Métabolisme des glucides</td><td><div><p>Fonctions impliquées dans le processus par lequel les glucides du régime alimentaire sont emmagasinés et transformés en glucose, puis en dioxyde de carbone et en eau.</p>\n</div></td><td>b540</td><td>b5401</td><td><code>http://id.who.int/icd/entity/1507365179</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1507365179</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1507365179</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1507365179/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b540</td><td/><td>Carbohydrate metabolism</td></tr><tr><td style=\"white-space:nowrap\">d2408<a name=\"terminologie-icf-d2408\"> </a></td><td>Autres activités précisées pour faire face au stress et aux autres demandes psychologiques</td><td/><td>d240</td><td>d2408</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#639612322/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#639612322/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/639612322/other/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/639612322/other/postcoordinationScale/performance</code></td><td/><td/><td/><td>d240</td><td/><td>Other specified handling stress and other psychological demands</td></tr><tr><td style=\"white-space:nowrap\">s798<a name=\"terminologie-icf-s798\"> </a></td><td>Autres structures précisées liées au mouvement</td><td/><td>s710-s799</td><td>s798</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#644658903/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#644658903/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/644658903/other/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/644658903/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s710-s799</td><td/><td>Other specified structures related to movement</td></tr><tr><td style=\"white-space:nowrap\">d855<a name=\"terminologie-icf-d855\"> </a></td><td>Travail non rémunéré</td><td><div><p>S'investir dans tous les aspects d'un travail qui ne procure pas de revenu, à temps complet ou partiel, comme des activités organisées, exécutant les tâches qui en découlent, se présentant au travail à l'heure, supervisant d'autres travailleurs ou étant supervisé, effectuant les tâches requises seul ou en groupe, comme dans le cas d'un travail bénévole, d'une œuvre de bienfaisance, d'un travail pour une communauté ou un groupe religieux sans être rétribué, travailler à domicile sans rémunération.</p>\n</div></td><td>d840-d859</td><td>d855</td><td><code>http://id.who.int/icd/entity/1439346442</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1439346442</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1439346442</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1439346442/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1439346442/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d840-d859</td><td/><td>Non-remunerative employment</td></tr><tr><td style=\"white-space:nowrap\">s7609<a name=\"terminologie-icf-s7609\"> </a></td><td>Structure non précisée du tronc</td><td/><td>s760</td><td>s7609</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#723417607/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#723417607/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/723417607/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/723417607/unspecified/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s760</td><td/><td>Structure of trunk, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d839<a name=\"terminologie-icf-d839\"> </a></td><td>Autres domaines de l'éducation, précisés ou non précisés</td><td/><td>d810-d839</td><td>d839</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#49044301/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#49044301/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/49044301/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/49044301/unspecified/postcoordinationScale/performance</code></td><td/><td/><td/><td>d810-d839</td><td/><td>Education, other specified and unspecified</td></tr><tr><td style=\"white-space:nowrap\">b7101<a name=\"terminologie-icf-b7101\"> </a></td><td>Mobilité de plusieurs articulations</td><td><div><p>Fonctions relatives à l'amplitude et à la facilité de mouvement de plus d'une articulation.</p>\n</div></td><td>b710</td><td>b7101</td><td><code>http://id.who.int/icd/entity/1757783224</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1757783224</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1757783224</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1757783224/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b710</td><td/><td>Mobility of several joints</td></tr><tr><td style=\"white-space:nowrap\">b235<a name=\"terminologie-icf-b235\"> </a></td><td>Fonctions vestibulaires</td><td><div><p>Fonctions sensorielles de l'oreille interne associées à la position, à l'équilibre et au mouvement.</p>\n</div></td><td>b230-b249</td><td>b235</td><td><code>http://id.who.int/icd/entity/1607952955</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1607952955</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1607952955</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1607952955/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b230-b249</td><td>b2351, b2352, b2359, b2358, b2350</td><td>Vestibular functions</td></tr><tr><td style=\"white-space:nowrap\">b1149<a name=\"terminologie-icf-b1149\"> </a></td><td>Fonctions non précisées d'orientation</td><td/><td>b114</td><td>b1149</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1670590220/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1670590220/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1670590220/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b114</td><td/><td>Orientation functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d199<a name=\"terminologie-icf-d199\"> </a></td><td>Apprendre et appliquer des connaissances, formes non précisées</td><td/><td>d110-d199</td><td>d199</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2011053685/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2011053685/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2011053685/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/2011053685/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d110-d199</td><td/><td>Learning and applying knowledge, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d1759<a name=\"terminologie-icf-d1759\"> </a></td><td>Résoudre des problèmes non précisés</td><td/><td>d175</td><td>d1759</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#126518990/unspecified</code>, <code>https://icd.