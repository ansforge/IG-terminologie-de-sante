d/release/11/2026-01/icf/439986917/postcoordinationScale/performance</code></td><td/><td/><td/><td>d335</td><td/><td>Producing signs and symbols</td></tr><tr><td style=\"white-space:nowrap\">e5559<a name=\"terminologie-icf-e5559\"> </a></td><td>Services, systèmes et politiques non précisés relatifs aux associations et aux services d'entraide</td><td/><td>e555</td><td>e5559</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#857780254/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#857780254/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/857780254/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e555</td><td/><td>Associations and organizational services, systems and policies, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b1601<a name=\"terminologie-icf-b1601\"> </a></td><td>Forme de la pensée</td><td><div><p>Fonctions mentales qui organisent le processus mental en ce qui concerne sa cohérence et sa logique.</p>\n</div></td><td>b160</td><td>b1601</td><td><code>http://id.who.int/icd/entity/1246047776</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1246047776</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1246047776</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1246047776/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b160</td><td/><td>Form of thought</td></tr><tr><td style=\"white-space:nowrap\">s75028<a name=\"terminologie-icf-s75028\"> </a></td><td>Autre structure précisée de la cheville et du pied</td><td/><td>s7502</td><td>s75028</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#933576740/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#933576740/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/933576740/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/933576740/other/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s7502</td><td/><td>Other specified structure of ankle and foot</td></tr><tr><td style=\"white-space:nowrap\">d860<a name=\"terminologie-icf-d860\"> </a></td><td>Transactions économiques élémentaires</td><td><div><p>S'investir dans toute forme de transaction économique simple, comme utiliser de l'argent pour acheter de la nourriture ou faire du troc, échanger des biens et des services ; ou économiser de l'argent.</p>\n</div></td><td>d860-d879</td><td>d860</td><td><code>http://id.who.int/icd/entity/1180561890</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1180561890</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1180561890</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1180561890/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1180561890/postcoordinationScale/performance</code></td><td/><td/><td/><td>d860-d879</td><td/><td>Basic economic transactions</td></tr><tr><td style=\"white-space:nowrap\">s8308<a name=\"terminologie-icf-s8308\"> </a></td><td>Autre structure précisée des ongles</td><td/><td>s830</td><td>s8308</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1322768357/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1322768357/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1322768357/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1322768357/other/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s830</td><td/><td>Other specified structure of nails</td></tr><tr><td style=\"white-space:nowrap\">b6100<a name=\"terminologie-icf-b6100\"> </a></td><td>Filtration de l'urine</td><td><div><p>Fonctions de filtration de l'urine par les reins.</p>\n</div></td><td>b610</td><td>b6100</td><td><code>http://id.who.int/icd/entity/2119712107</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2119712107</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2119712107</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2119712107/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b610</td><td/><td>Filtration of urine</td></tr><tr><td style=\"white-space:nowrap\">b765<a name=\"terminologie-icf-b765\"> </a></td><td>Fonctions relatives aux mouvements involontaires</td><td><div><p>Fonctions relatives aux contractions involontaires, non intentionnelles ou semi-intentionnelles, d'un muscle ou d'un groupe de muscles.</p>\n</div></td><td>b750-b789</td><td>b765</td><td><code>http://id.who.int/icd/entity/2055053578</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#2055053578</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#2055053578</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2055053578/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b750-b789</td><td>b7658, b7652, b7653, b7659, b7650, b7651</td><td>Involuntary movement functions</td></tr><tr><td style=\"white-space:nowrap\">e5750<a name=\"terminologie-icf-e5750\"> </a></td><td>Services sociaux généraux</td><td><div><p>Services et programmes visant à apporter une aide sociale aux personnes qui, en raison de leur âge, de leurs moyens financiers, du chômage, de leur état de santé ou d'une incapacité, ont besoin d'aide pour faire leurs courses, pour les travaux ménagers, les transports, leur entretien personnel et l'entretien des autres, afin de leur permettre d'avoir une vie aussi normale que possible.</p>\n</div></td><td>e575</td><td>e5750</td><td><code>http://id.who.int/icd/entity/509195709</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#509195709</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#509195709</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/509195709/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e575</td><td/><td>General social support services</td></tr><tr><td style=\"white-space:nowrap\">d799<a name=\"terminologie-icf-d799\"> </a></td><td>Relations et interactions avec autrui non précisées</td><td/><td>d710-d799</td><td>d799</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#982325691/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#982325691/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/982325691/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/982325691/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d710-d799</td><td/><td>Interpersonal interactions and relationships, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d550<a name=\"terminologie-icf-d550\"> </a></td><td>Manger</td><td><div><p>Coordonner les gestes nécessaires pour préparer des aliments qui ont été servis, les porter à la bouche, les consommer de façon culturellement acceptable, comme couper ou rompre la nourriture en petits morceaux, ouvrir les bouteilles et les canettes, utiliser des objets pour se nourrir, prendre des repas, festoyer, dîner.</p>\n</div></td><td>d510-d599</td><td>d550</td><td><code>http://id.who.int/icd/entity/1328675264</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1328675264</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1328675264</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1328675264/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1328675264/postcoordinationScale/performance</code></td><td/><td/><td/><td>d510-d599</td><td/><td>Eating</td></tr><tr><td style=\"white-space:nowrap\">e5609<a name=\"terminologie-icf-e5609\"> </a></td><td>Services, systèmes et politiques non précisés relatifs aux médias</td><td/><td>e560</td><td>e5609</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#548925174/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#548925174/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/548925174/unspecified/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e560</td><td/><td>Media services, systems and policies, unspecified</td></tr><tr><td style=\"white-space:nowrap\">b4552<a name=\"terminologie-icf-b4552\"> </a></td><td>Fatigabilité</td><td><div><p>Fonctions relatives à la prédisposition à la fatigue, quel que soit le niveau d'effort.</p>\n</div></td><td>b455</td><td>b4552</td><td><code>http://id.who.int/icd/entity/1848351881</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1848351881</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1848351881</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1848351881/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b455</td><td/><td>Fatiguability</td></tr><tr><td style=\"white-space:nowrap\">s75018<a name=\"terminologie-icf-s75018\"> </a></td><td>Autre structure précisée de la jambe</td><td/><td>s7501</td><td>s75018</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#249425252/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#249425252/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/249425252/other/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/249425252/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s7501</td><td/><td>Other specified structure of lower leg</td></tr><tr><td style=\"white-space:nowrap\">b5409<a name=\"terminologie-icf-b5409\"> </a></td><td>Fonctions métaboliques générales non précisées</td><td/><td>b540</td><td>b5409</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#41561686/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#41561686/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/41561686/unspecified/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b540</td><td/><td>General metabolic functions, unspecified</td></tr><tr><td style=\"white-space:nowrap\">d110-d999<a name=\"terminologie-icf-d110-d999\"> </a></td><td>Activités et participation</td><td><div><p>Une activité signifie l'exécution d'une tâche ou le fait pour une personne de faire quelque chose.\nLa participation signifie le fait de prendre part à une situation de la vie réelle.\nLes limitations d'activité désignent les difficultés qu'une personne peut rencontrer pour mener une activité.\nLes restrictions de participation désignent les problèmes qu'une personne peut rencontrer pour participer à une situation réelle.\nLes domaines qui décrivent la composante Activités et participation font l'objet d'une liste unique qui couvre l'ensemble des domaines de la vie (allant de l'apprentissage élémentaire aux domaines plus composites comme ceux qui représentent les tâches sociales). Cette composante peut être utilisée pour dénoter des activités (a), ou la participation (p), ou les deux à la fois. Deux codes qualificatifs s'appliquent à la composante Activités et participation : le code qualificatif de performance et le code qualificatif de capacité. Le code qualificatif de performance décrit ce que la personne fait dans son cadre de vie habituel. Cet environnement impliquant un contexte sociétal, la performance telle qu'elle est notée par ce code qualificatif peut aussi être entendue comme \"implication dans une situation de la vie réelle\" ou \"expérience vécue\" par les personnes dans leur cadre de vie habituel. Ce cadre de vie comprend les facteurs environnementaux, c'est à dire tous les aspects du monde physique, social et attitudinal, qui peut être codé en utilisant la composante Facteurs environnementaux. Le code qualificatif de capacité se réfère à l'aptitude qu'a une personne à effectuer une tâche ou mener une action. Ce code qualificatif définit le niveau de fonctionnement le plus élevé qu'une personne est susceptible d'atteindre dans un domaine donné à un moment donné. La capacité est évaluée dans un environnement uniforme ou normalisé, et reflète donc l'aptitude de la personne ajustée des facteurs environnementaux. La composante Facteurs environnementaux peut être utilisée pour décrire les caractéristiques de cet environnement uniforme.\nLes codes qualificatifs de performance et de capacité peuvent être utilisés l'un comme l'autre en tenant compte ou non de l'utilisation d'aides techniques ou de la présence d'aides humaines, en se référant à l'échelle suivante :</p>\n</div></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/619527855</code></td><td/><td><code>http://id.who.int/icd/entity/1394728112</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1394728112</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1394728112</code></td><td/><td>BlockL1-d11</td><td>d110-d999</td><td/><td/><td>d510-d599, d710-d799, d410-d499, d810-d899, d610-d699, d310-d399, d910-d999, d110-d199, d210-d299</td><td>Activities and participation</td></tr><tr><td style=\"white-space:nowrap\">s4208<a name=\"terminologie-icf-s4208\"> </a></td><td>Autre structure précisée du système immunitaire</td><td/><td>s420</td><td>s4208</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1336997472/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1336997472/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1336997472/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1336997472/other/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s420</td><td/><td>Other specified structure of immune system</td></tr><tr><td style=\"white-space:nowrap\">e5308<a name=\"terminologie-icf-e5308\"> </a></td><td>Autres services, systèmes et politiques précisés relatifs aux services de première nécessité</td><td/><td>e530</td><td>e5308</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#929819250/other</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#929819250/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/929819250/other/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e530</td><td/><td>Other specified utilities services, systems and policies</td></tr><tr><td style=\"white-space:nowrap\">e1351<a name=\"terminologie-icf-e1351\"> </a></td><td>Aides techniques pour l'emploi</td><td><div><p>Produits, équipements et systèmes techniques, adaptés ou spécialement conçus, utilisés dans le monde du travail pour faciliter l'exécution de certaines tâches, comme des tables, des bureaux et des armoires réglables, des portes de bureau à ouverture et fermeture télécommandées, du matériel informatique, des logiciels et autres accessoires et appareils de réalité virtuelle destinés à faciliter l'exécution des tâches de travail et à maîtriser son environnement (par ex. scanner, système de commande à distance, système de commande vocale, minuterie).</p>\n</div></td><td>e135</td><td>e1351</td><td><code>http://id.who.int/icd/entity/624079831</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#624079831</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#624079831</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/624079831/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e135</td><td/><td>Assistive products and technology for employment</td></tr><tr><td style=\"white-space:nowrap\">s12002<a name=\"terminologie-icf-s12002\"> </a></td><td>Région lombaire</td><td/><td>s1200</td><td>s12002</td><td><code>http://id.who.int/icd/entity/406851865</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#406851865</code>, <code>https://icd.who.int/browse/2026-01/icf/en#406851865</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/406851865/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/406851865/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s1200</td><td/><td>Lumbosacral spinal cord</td></tr><tr><td style=\"white-space:nowrap\">d2400<a name=\"terminologie-icf-d2400\"> </a></td><td>Assumer ses responsabilités</td><td><div><p>Effectuer les actions simples ou complexes et coordonnées qu'une personne doit accomplir pour assumer les responsabilités de la réalisation de certaines tâches et évaluer les implications de ces responsabilités.</p>\n</div></td><td>d240</td><td>d2400</td><td><code>http://id.who.int/icd/entity/1011135336</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1011135336</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1011135336</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1011135336/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1011135336/postcoordinationScale/performance</code></td><td/><td/><td/><td>d240</td><td/><td>Handling responsibilities</td></tr><tr><td style=\"white-space:nowrap\">s73002<a name=\"terminologie-icf-s73002\"> </a></td><td>Muscles du bras</td><td/><td>s7300</td><td>s73002</td><td><code>http://id.who.int/icd/entity/1867012554</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1867012554</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1867012554</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1867012554/postcoordinationScale/extentOrMagnitudeOfImpairment</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1867012554/postcoordinationScale/natureOfChangeInBodyStructure</code></td><td/><td/><td/><td>s7300</td><td/><td>Muscles of upper arm</td></tr><tr><td style=\"white-space:nowrap\">d6403<a name=\"terminologie-icf-d6403\"> </a></td><td>Utiliser des appareils électroménagers</td><td><div><p>Utiliser tous les types d'appareils électroménagers, comme les lave-linge, les sèche-linge, les fers à repasser, les aspirateurs et les lave-vaisselle.</p>\n</div></td><td>d640</td><td>d6403</td><td><code>http://id.who.int/icd/entity/65792596</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#65792596</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#65792596</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/65792596/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/65792596/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d640</td><td/><td>Using household appliances</td></tr><tr><td style=\"white-space:nowrap\">d299<a name=\"terminologie-icf-d299\"> </a></td><td>Tâches et exigences générales non précisées</td><td/><td>d210-d299</td><td>d299</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1228414013/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1228414013/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1228414013/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1228414013/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d210-d299</td><td/><td>General tasks and demands, unspecified</td></tr><tr><td style=\"white-space:nowrap\">e1200<a name=\"terminologie-icf-e1200\"> </a></td><td>Produits et systèmes techniques généraux pour la mobilité et le transport à l'intérieur et à l'extérieur des bâtiments</td><td><div><p>Produits, équipements et systèmes techniques utilisés pour se déplacer à l'intérieur et à l'extérieur des bâtiments, comme des véhicules motorisés et non motorisés pour le transport de personnes sur terre, sur l'eau et dans les airs (bus, voitures, camions, autres véhicules à moteur, moyens de transport à traction animale), et qui n'ont pas été adaptés ou spécialement conçus.</p>\n</div></td><td>e120</td><td>e1200</td><td><code>http://id.who.int/icd/entity/1025805050</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#1025805050</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#1025805050</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1025805050/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e120</td><td/><td>General products and technology for personal indoor and outdoor mobility and transportation</td></tr><tr><td style=\"white-space:nowrap\">b21023<a name=\"terminologie-icf-b21023\"> </a></td><td>Qualité de l'image visuelle</td><td><div><p>Fonctions visuelles impliquant la qualité de l'image .</p>\n</div></td><td>b2102</td><td>b21023</td><td><code>http://id.who.int/icd/entity/2091905196</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#2091905196</code>, <code>https://icd.who.int/browse/2026-01/icf/en#2091905196</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/2091905196/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b2102</td><td/><td>Visual picture quality</td></tr><tr><td style=\"white-space:nowrap\">d7509<a name=\"terminologie-icf-d7509\"> </a></td><td>Relations sociales informelles non précisées</td><td/><td>d750</td><td>d7509</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1817637292/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1817637292/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1817637292/unspecified/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1817637292/unspecified/post