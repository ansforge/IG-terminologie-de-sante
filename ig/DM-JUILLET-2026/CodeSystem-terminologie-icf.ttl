  ], [
     fhir:index 696 ;
     fhir:CodeSystem.concept.code [ fhir:value "d820" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Éducation scolaire" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Accéder à l'école, à l’éducation, participer à toutes les activités scolaires, avec leurs responsabilités et leurs privilèges, apprendre les leçons, les matières et satisfaire aux exigences du programme dans un programme d'éducation primaire ou secondaire, y compris fréquenter l'école régulièrement, travailler en coopération avec d'autres élèves, suivre les instructions des enseignants, l'organisation, l'étude et l'achèvement des tâches et des projets à réaliser, et progresser vers d'autres niveaux d'éducation." ] ;
