     fhir:CodeSystem.concept.display [ fhir:value "Produits et systèmes techniques de l'architecture, de la construction et des aménagements des bâtiments pour la sécurité physique des personnes dans les bâtiments à usage privé" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Produits et systèmes techniques d'intérieur et d'extérieur à usage privé (dans une maison ou un logement par exemple) permettant d'assurer la sécurité, comme les barrières de sécurité, les signaux d'alarme et d'assurer le rangement sécurisé d'objets ou produits dangereux (comme les armes, les solvants, les insecticides)." ] ;
