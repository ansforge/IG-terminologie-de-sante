26-01/icf/1620689425/postcoordinationScale/capacity</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1620689425/postcoordinationScale/performance</code></td><td/><td/><td/><td>d840-d859</td><td/><td>Apprenticeship (work preparation)</td></tr><tr><td style=\"white-space:nowrap\">s110-s199<a name=\"terminologie-icf-s110-s199\"> </a></td><td>Structures du système nerveux</td><td/><td>s110-s899</td><td/><td><code>http://id.who.int/icd/entity/1419635799</code></td><td>block</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1419635799</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1419635799</code></td><td/><td>BlockL2-s11</td><td>s110-s199</td><td/><td>s110-s899</td><td>s120, s110, s198, s199, s140, s130, s150</td><td>Structures of the nervous system</td></tr><tr><td style=\"white-space:nowrap\">s11051<a name=\"terminologie-icf-s11051\"> </a></td><td>Pont</td><td/><td>s1105</td><td>s11051</td><td><code>http://id.who.int/icd/entity/876265464</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#876265464</code>, <code>https://icd.who.int/browse/2026-01/icf/fr#876265464</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/876265464/postcoordinationScale/natureOfChangeInBodyStructure</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/876265464/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>s1105</td><td/><td>Pons</td></tr><tr><td style=\"white-space:nowrap\">d4359<a name=\"terminologie-icf-d4359\"> </a></td><td>Activités non précisées de déplacement d'objets avec les membres inférieurs</td><td/><td>d435</td><td>d4359</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1706408388/unspecified</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1706408388/unspecified</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1706408388/unspecified/postcoordinationScale/performance</code>, <code>http://id.who.int/icd/release/11/2026-01/icf/1706408388/unspecified/postcoordinationScale/capacity</code></td><td/><td/><td/><td>d435</td><td/><td>Moving objects with lower extremities, unspecified</td></tr><tr><td style=\"white-space:nowrap\">e255<a name=\"terminologie-icf-e255\"> </a></td><td>Vibration</td><td><div><p>Mouvement de va-et-vient régulier ou irrégulier d'un objet ou d'un individu causé par une perturbation physique, soit interne, soit externe, comme un tremblement, un frémissement, des mouvements rapides et saccadés d’objets, d’immeubles ou de personnes, causés par le fait de manipuler ou de travailler avec de petits ou de gros outils ou équipements.</p>\n</div></td><td>e210-e299</td><td>e255</td><td><code>http://id.who.int/icd/entity/337392840</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#337392840</code>, <code>https://icd.who.int/browse/2026-01/icf/en#337392840</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/337392840/postcoordinationScale/barrierOrFacilitator</code></td><td/><td/><td/><td>e210-e299</td><td/><td>Vibration</td></tr><tr><td style=\"white-space:nowrap\">b6708<a name=\"terminologie-icf-b6708\"> </a></td><td>Autres sensations précisées associées aux fonctions génitales et reproductives</td><td/><td>b670</td><td>b6708</td><td/><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/fr#1473025402/other</code>, <code>https://icd.who.int/browse/2026-01/icf/en#1473025402/other</code></td><td><code>http://id.who.int/icd/release/11/2026-01/icf/1473025402/other/postcoordinationScale/extentOrMagnitudeOfImpairment</code></td><td/><td/><td/><td>b670</td><td/><td>Other specified sensations associated with genital and reproductive functions</td></tr><tr><td style=\"white-space:nowrap\">s12003<a name=\"terminologie-icf-s12003\"> </a></td><td>Cauda equina</td><td/><td>s1200</td><td>s12003</td><td><code>http://id.who.int/icd/entity/258504153</code></td><td>category</td><td><code>https://icd.who.int/browse/2026-01/icf/en#258504153</